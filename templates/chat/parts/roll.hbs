{{!-- Кости и сумма броска. Итог стоит в шапке карточки, здесь — из чего он вышел. Контекст — результат performCheck. --}}
<div class="roll-line">
  <span class="dice">
    {{#each dice}}<span class="die d10{{#if (eq this 10)}} max{{/if}}{{#if (eq this 1)}} min{{/if}}">{{this}}</span>{{/each}}
    {{#if fumble}}
      <span class="minus">−</span>
      {{#each fumbleDice}}<span class="die d10 fumble-die{{#if (eq this 10)}} max{{/if}}">{{this}}</span>{{/each}}
    {{/if}}
  </span>
  <span class="roll-sum">основа <b>{{base}}</b> {{#if fumble}}− <b>{{fumbleValue}}</b>{{else}}+ <b>{{vedmakSum dice}}</b>{{/if}}</span>
</div>

{{#if crit}}<div class="badge crit"><i class="fa-solid fa-star"></i> Критический успех{{#if critValue}}: +{{critValue}} сверх десятки{{/if}}</div>{{/if}}
{{#if fumble}}<div class="badge fumble"><i class="fa-solid fa-skull"></i> Критический провал: −{{fumbleValue}}</div>{{/if}}

<details class="roll-parts">
  <summary>из чего сложилось</summary>
  <ul class="parts">
    {{#each parts}}<li><span>{{label}}</span><b>{{vedmakSigned value}}</b></li>{{/each}}
    {{#if luck}}<li class="luck"><span>Удача</span><b>+{{luck}}</b></li>{{/if}}
    {{#if fumble}}
      <li class="fumble-line"><span>Провал: вычесть из основы</span><b>−{{fumbleValue}}</b></li>
    {{else}}
      <li><span>Бросок d10</span><b>+{{vedmakSum dice}}</b></li>
    {{/if}}
  </ul>
</details>

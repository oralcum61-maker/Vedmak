{{!-- Броски жизненного пути (module/character/lifepath.mjs → postLifepathRolls): по разделам, у каждого броска —
      кость, что бросали и что выпало. d10 — гранёной костью без крита и провала (plain), другие кости — монетой. --}}
<div class="vedmak-card lifepath-roll">
  <header class="card-head">
    <span class="lp-seal" aria-hidden="true"><i class="fa-solid fa-scroll"></i></span>
    <div class="card-ident">
      <span class="card-name">{{title}}</span>
      {{#if subtitle}}<span class="card-sub">{{subtitle}}</span>{{/if}}
    </div>
  </header>
  <div class="card-body">
    {{#each groups as |g|}}
    {{#if g.section}}<div class="lp-chat-section">{{g.section}}</div>{{/if}}
    <div class="lp-chat-rows">
      {{#each g.rows as |r|}}
      <div class="lp-chat-row">
        {{#if (eq r.sides 10)}}{{> "systems/vedmak/templates/chat/parts/die.hbs" v=r.value plain=true}}
        {{else}}<span class="die dn" data-tooltip="d{{r.sides}}" aria-label="d{{r.sides}}: {{r.value}}"><b>{{r.value}}</b></span>{{/if}}
        <div class="lp-chat-text">
          <span class="lp-chat-label">{{r.label}}</span>
          <span class="lp-chat-result">{{#if r.title}}<b>{{r.title}}.</b> {{/if}}{{r.text}}{{#if r.detail}} <i>{{r.detail}}</i>{{/if}}</span>
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
</div>

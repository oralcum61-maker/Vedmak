{{!-- Приглашение защищаться от скрытой атаки (combat/attack.mjs, PLAN 4.263): ведущий бросил попадание скрыто, владелец
     цели защищается здесь. Числа атаки нет; кнопки — те же, что на карточке атаки --}}
<div class="vedmak-card attack defense-prompt">
  <header class="card-head">
    <img src="{{img}}" alt="">
    <div class="card-ident">
      <span class="card-name">{{attacker.name}} атакует</span>
      <span class="card-sub">{{label}} · {{typeLabel}}{{#if aimLabel}} · в {{aimLabel}}{{/if}}{{#if bandLabel}} · {{bandLabel}}{{/if}}</span>
    </div>
    <div class="card-value"><b>?</b><span class="cap">атака</span></div>
  </header>
  <div class="card-body"><p class="note dim">Ведущий бросил атаку скрыто — защищайтесь: результат увидите в итоге.</p></div>
  <div class="card-section">
    <h4>{{#if hasTargets}}Защищается{{else}}Защищается выделенный токен{{/if}}</h4>
    {{#each targets}}
    <div class="target-row" data-target-token="{{tokenUuid}}" data-target-actor="{{actorUuid}}">
      <div class="target-name"><img src="{{img}}" alt=""><span class="name">{{name}}</span></div>
      <div class="defense-buttons">
        <button type="button" data-vedmak="defend" data-defense="dodge" data-tooltip="Уклонение"><span>Уклон</span></button>
        <button type="button" data-vedmak="defend" data-defense="reposition" data-tooltip="Изменение позиции"><span>Позиция</span></button>
        <button type="button" data-vedmak="defend" data-defense="block" data-tooltip="Блокирование"><span>Блок</span></button>
        {{#if @root.isRanged}}<button type="button" data-vedmak="defend" data-defense="deflect" data-tooltip="Отбивание стрел (ведьмак, −3)"><span>Отбить</span></button>
        {{else}}<button type="button" data-vedmak="defend" data-defense="parry" data-tooltip="Парирование (−3)"><span>Парир.</span></button>{{/if}}
        <button type="button" data-vedmak="defend" data-defense="none" data-tooltip="Без защиты: против СЛ (беззащитна, дезориентирована)"><span>СЛ</span></button>
      </div>
    </div>
    {{else}}
    <div class="target-row any">
      <div class="defense-buttons">
        <button type="button" data-vedmak="defend" data-defense="dodge" data-tooltip="Уклонение"><span>Уклон</span></button>
        <button type="button" data-vedmak="defend" data-defense="reposition" data-tooltip="Изменение позиции"><span>Позиция</span></button>
        <button type="button" data-vedmak="defend" data-defense="block" data-tooltip="Блокирование"><span>Блок</span></button>
        {{#if @root.isRanged}}<button type="button" data-vedmak="defend" data-defense="deflect" data-tooltip="Отбивание стрел (ведьмак, −3)"><span>Отбить</span></button>
        {{else}}<button type="button" data-vedmak="defend" data-defense="parry" data-tooltip="Парирование (−3)"><span>Парир.</span></button>{{/if}}
        <button type="button" data-vedmak="defend" data-defense="none" data-tooltip="Без защиты: против СЛ"><span>СЛ</span></button>
      </div>
    </div>
    {{/each}}
  </div>
</div>

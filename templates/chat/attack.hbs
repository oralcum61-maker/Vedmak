<div class="vedmak-card attack{{#if roll.crit}} is-crit{{/if}}{{#if roll.fumble}} is-fumble{{/if}}">
  <header class="card-head">
    <img src="{{img}}" alt="">
    <div class="card-ident">
      <span class="card-name">{{label}}</span>
      <span class="card-sub">{{typeLabel}}{{#if aimLabel}} · в {{aimLabel}}{{/if}}{{#if bandLabel}} · {{bandLabel}}{{/if}}{{#if attackSpeed}} · СА {{attackSpeed}}{{/if}}</span>
    </div>
    <div class="card-value">
      <b>{{roll.total}}</b>
      <span class="cap">атака</span>
    </div>
  </header>

  <div class="card-body">
    {{#with roll}}{{> "systems/vedmak/templates/chat/parts/roll.hbs"}}{{/with}}
    {{#if fumbleText}}<div class="fumble-note"><b>{{fumbleLabel}}:</b> {{fumbleText}}</div>{{/if}}
    {{#if mounted}}<p class="note dim">Верхом: проверка управления при каждой атаке.{{#if chargeDice}} Разбег +{{chargeDice}}d6{{#if (ne weightMult 1)}} ×{{weightMult}}{{/if}}.{{/if}}</p>{{/if}}
    {{#each notes}}<p class="note">{{this}}</p>{{/each}}
    {{#if typeHint}}<p class="note dim">{{typeHint}}</p>{{/if}}
  </div>

  <div class="card-section">
    <h4>{{#if hasTargets}}Защищается{{else}}Защищается выделенный токен{{/if}}</h4>
    {{#each targets}}
    <div class="target-row" data-target-token="{{tokenUuid}}" data-target-actor="{{actorUuid}}">
      <div class="target-name"><img src="{{img}}" alt=""><span class="name">{{name}}</span></div>
      <div class="defense-buttons">
        <button type="button" data-vedmak="defend" data-defense="dodge" data-tooltip="Уклонение"><span>Уклон</span></button>
        <button type="button" data-vedmak="defend" data-defense="reposition" data-tooltip="Изменение позиции"><span>Позиция</span></button>
        <button type="button" data-vedmak="defend" data-defense="block" data-tooltip="Блокирование"><span>Блок</span></button>
        <button type="button" data-vedmak="defend" data-defense="parry" data-tooltip="Парирование (−3)"><span>Парир.</span></button>
        <button type="button" data-vedmak="defend" data-defense="none" data-tooltip="Без защиты: против СЛ (беззащитна, дезориентирована)"><span>СЛ</span></button>
      </div>
    </div>
    {{else}}
    <div class="target-row any">
      <div class="defense-buttons">
        <button type="button" data-vedmak="defend" data-defense="dodge" data-tooltip="Уклонение"><span>Уклон</span></button>
        <button type="button" data-vedmak="defend" data-defense="reposition" data-tooltip="Изменение позиции"><span>Позиция</span></button>
        <button type="button" data-vedmak="defend" data-defense="block" data-tooltip="Блокирование"><span>Блок</span></button>
        <button type="button" data-vedmak="defend" data-defense="parry" data-tooltip="Парирование (−3)"><span>Парир.</span></button>
        <button type="button" data-vedmak="defend" data-defense="none" data-tooltip="Без защиты: против СЛ"><span>СЛ</span></button>
      </div>
    </div>
    {{/each}}
  </div>

  <div class="card-buttons">
    <button type="button" class="quiet" data-vedmak="repeatAttack">Ещё атака</button>
  </div>
</div>

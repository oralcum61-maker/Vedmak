{{!-- Неделя поселения (PLAN 4.185): броски построек, итог склада, нехватки, события месяца, достроенное. --}}
<div class="vedmak-card settlement-week">
  <header class="card-head">
    <div class="card-ident">
      <span class="card-name">{{name}}</span>
      <span class="card-sub">{{report.monthLabel}}, {{report.week}}-я неделя · {{report.season}} · год {{report.year}}</span>
    </div>
  </header>
  <div class="card-body">
    {{#if lines.length}}
    <ul class="sw-lines">
      {{#each lines}}<li><span>{{building}}: {{resource}}</span><b>+{{amount}}</b><em>{{formula}}{{#if dice}} · {{dice}}{{/if}}</em></li>{{/each}}
    </ul>
    {{/if}}
    {{#if net.length}}
    <ul class="sw-res">
      {{#each net}}<li><img src="{{img}}" alt=""><span>{{label}}</span><b class="{{#if plus}}up{{else}}down{{/if}}">{{#if plus}}+{{/if}}{{net}}</b></li>{{/each}}
    </ul>
    {{/if}}
    {{#if wealth}}<p class="note">Казна: <b>{{wealth}}</b>.</p>{{/if}}
    {{#if shortages}}<p class="note warn">Не хватило: {{shortages}}.</p>{{/if}}
    {{#each report.events}}<p class="note{{#if danger}} warn{{/if}}">{{text}}</p>{{/each}}
    {{#if built}}<p class="note"><b>Достроено:</b> {{built}}.</p>{{/if}}
    {{#if army.length}}<p class="note"><b>Войско</b>{{#if armyHungry}} <span class="warn">— еды не хватило</span>{{/if}}:</p>
    <ul class="sw-army">{{#each army}}<li>{{name}}{{#if notes}} — {{notes}}{{/if}}</li>{{/each}}</ul>{{/if}}
    {{#if overflow}}<p class="note dim">Не влезло на склад и пропало: {{overflow}}.</p>{{/if}}
  </div>
</div>

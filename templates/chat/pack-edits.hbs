{{!-- Правки компендиумов возвращены после обновления системы (apps/pack-edits.mjs, PLAN 4.255) --}}
<div class="vedmak-card pack-edits-card">
  <header class="card-head"><div class="card-ident"><span class="card-name">Правки компендиумов возвращены</span>
    <span class="card-sub">после обновления системы · {{done.length}}</span></div></header>
  <div class="card-body"><ul class="pe-done">{{#each done}}<li>{{this}}</li>{{/each}}</ul></div>
</div>

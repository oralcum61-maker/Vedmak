{{!-- Подвал окна: во что сложится бросок. Контекст — объект total.
      «d10 +» и число пишет bindDialog (module/dice/dialog-ui.mjs) в data-total-dx / data-total-roll, строку «основа · правки · Удача» — в data-total-parts. --}}
<footer class="dlg-total">
  {{#unless noRoll}}
  <div class="tot roll">
    <span class="cap">БРОСОК</span>
    <span class="tot-roll"><span class="dx" data-total-dx>d10 +</span><b data-total-roll>{{base}}</b></span>
    <span class="tot-parts" data-total-parts>основа {{base}}</span>
  </div>
  {{/unless}}
  {{#if damage}}
  <div class="tot dmg">
    <span class="cap">УРОН</span>
    <b data-total-damage data-damage="{{damage}}">{{damage}}</b>
  </div>
  {{/if}}
  <span class="tot-hint" data-total-hint>{{hint}}</span>
</footer>

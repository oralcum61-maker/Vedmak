{{!-- Нанесение татуировки («Офир и Зеррикания», стр. 78–81; module/crafting/tattoo.mjs): место — кованой частью тела
      с занятыми местами, кто наносит, Искусство против СЛ. --}}
<div class="vedmak-roll-dialog tattoo-dialog">
  <header class="dlg-head">
    <span class="dlg-frame"><img src="{{img}}" alt=""></span>
    <div class="dlg-ident">
      <span class="dlg-title">{{name}}</span>
      <span class="dlg-sub">{{tier}}{{#if achievement}} · {{achievement}}{{/if}}</span>
      {{#if tries}}<span class="dlg-sub warn">Прежних неудач: {{tries}} — СЛ выше книжной на {{tries}}</span>{{/if}}
    </div>
    <div class="dlg-base">
      {{> "systems/vedmak/templates/actor/parts/medal.hbs" value=dc cls="md"}}
      <span class="cap">СЛ</span><span class="cap dim">Искусство</span>
    </div>
  </header>

  <div class="dlg-body">
    <div class="dlg-group">
      <span class="dlg-label">МЕСТО НА ТЕЛЕ <span class="dim">· занято из мест</span></span>
      <div class="loc-row">
        {{#each places}}
        <label class="opt loc{{#if full}} full{{/if}}" data-tooltip="{{label}}: {{used}} из {{max}}{{#if full}} — места нет{{/if}}">
          <input type="radio" name="location" value="{{key}}" {{#if full}}disabled{{/if}} {{checked selected}}>
          <span><span class="loc-glyph {{glyph}}{{#if flip}} flip{{/if}}" aria-hidden="true"></span><span class="loc-name">{{label}}</span><em class="{{#if full}}bad{{/if}}">{{used}}/{{max}}</em></span>
        </label>
        {{/each}}
      </div>
    </div>

    <div class="dlg-group">
      <span class="dlg-label">КТО НАНОСИТ <span class="dim">· Рем + Искусство</span></span>
      <div class="opt-row">
        {{#each artists}}
        <label class="chip"><input type="radio" name="artist" value="{{id}}" {{checked selected}}><span>{{name}} <b>{{base}}</b></span></label>
        {{/each}}
      </div>
    </div>

    {{#if effect}}<p class="tattoo-effect">{{effect}}</p>{{/if}}
    <p class="hint">Нужны набор для татуировки и чернила. Провал — чернила потрачены, следующая попытка на 1 сложнее. Успех — Репутация +1.</p>
  </div>

  <footer class="dlg-total">
    <span class="tot-hint">Искусство против СЛ {{dc}}</span>
  </footer>
</div>

<div class="wizard">
  <nav class="wizard-steps">
    {{#each steps}}
    <a class="wstep{{#if active}} active{{/if}}{{#if done}} done{{/if}}{{#if problem}} problem{{/if}}" data-action="step" data-step="{{id}}" data-tooltip="{{#if problem}}{{problem}}{{else}}Готово{{/if}}">
      <i class="{{icon}}"></i><span>{{label}}</span>
    </a>
    {{/each}}
  </nav>

  <div class="wizard-body">

  {{!-- ============================== РАСА ============================== --}}
  {{#if is_race}}
    <div class="vd-panel wizard-basics">
      <label>Имя <input type="text" data-field="name" value="{{state.name}}"></label>
      <label>Пол <input type="text" data-field="gender" value="{{state.gender}}"></label>
      <label>Возраст <input type="number" data-field="age" value="{{state.age}}" min="0"></label>
    </div>
    <div class="card-grid">
      {{#each races}}
      <div class="pick-card{{#if selected}} selected{{/if}}" data-action="pickRace" data-uuid="{{uuid}}">
        <header><img src="{{img}}" alt=""><h3>{{name}}</h3></header>
        <div class="desc">{{{description}}}</div>
        <ul class="traits">
          {{#each traits}}<li><b>{{name}}.</b> {{effect}}</li>{{/each}}
        </ul>
      </div>
      {{else}}
      <p class="warning">Не найдено ни одной расы. Проверьте, что компендиум «Расы» системы доступен.</p>
      {{/each}}
    </div>
    <p class="hint">Социальный статус расы зависит от территории (стр. 21). Ведьмак может быть только ведьмаком, маг и жрец — только человек или эльф.</p>
  {{/if}}

  {{!-- =========================== ПРОИСХОЖДЕНИЕ ======================== --}}
  {{#if is_origin}}
    {{#if isWitcher}}
      <div class="vd-panel">
        <h3>Происхождение ведьмака</h3>
        <p>Ведьмаков забирают в школу детьми — вместо родины и семьи у них школа, тренировки и Испытание травами (следующий шаг).</p>
        <label>Родной язык (8)
          <select data-field="language">{{#each languages}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
      </div>
    {{else}}
      <div class="vd-panel">
        <h3>Откуда вы родом <a class="roll-btn" data-action="rollOrigin" data-tooltip="Бросить регион и родину"><i class="fa-solid fa-certificate"></i> Бросить</a></h3>
        <div class="wizard-basics">
          <label>Регион
            <select data-field="origin">
              <option value="" {{#unless state.origin}}selected{{/unless}}>—</option>
              {{#each origins}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label>Родина
            <select data-field="homeland">
              <option value="" {{#unless state.homeland}}selected{{/unless}}>—</option>
              {{#each homelands}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label>Родной язык (8)
            <select data-field="language">{{#each languages}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          </label>
        </div>
        {{#if homelandInfo}}<p>Бонус родины: <b>+1 к навыку «{{homelandSkill}}»</b>.</p>{{/if}}
        <p class="hint">{{originHint}} Нильфгаардцы: 1–3 — сердце Империи, 4–10 — вассальное государство (ещё d10). Родной язык: Север — всеобщий, Нильфгаард, Скеллиге и Доль Блатанна — Старшая Речь, Махакам — краснолюдский (стр. 25).</p>
      </div>
    {{/if}}
  {{/if}}

  {{!-- =========================== ЖИЗНЕННЫЙ ПУТЬ ======================= --}}
  {{#if is_lifepath}}
    <div class="vd-panel lifepath-toolbar">
      <label class="check"><input type="checkbox" data-field="lifepath" {{checked state.lifepath}}> Использовать жизненный путь</label>
      {{#if state.lifepath}}
        <label>Возраст <input type="number" data-field="age" value="{{state.age}}" min="0"></label>
        <a class="roll-btn" data-action="rerollAll"><i class="fa-solid fa-dice"></i> Перебросить всё</a>
      {{/if}}
      <span class="hint">{{#if isWitcher}}Ведьмак живёт от 50 до 260 лет; события — за каждое десятилетие странствий (стр. 241).{{else}}Событие — за каждые полные 10 лет жизни (стр. 31).{{/if}} Результат можно перебросить или выбрать из списка.</span>
    </div>
    {{#if state.lifepath}}
      {{#each lifepath as |sec|}}
      <div class="vd-panel lifepath-section">
        <h3>{{sec.title}}
          {{#if sec.riskOptions}}
          <label class="inline">Поведение
            <select data-field="risk.{{sec.decade}}">{{#each sec.riskOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          </label>
          {{/if}}
        </h3>
        {{#each sec.entries as |e|}}
        <div class="lp-entry{{#if e.sub}} sub{{/if}}">
          <div class="lp-label">{{e.label}}</div>
          <div class="lp-roll">
            {{#if e.path}}
              {{#if e.options}}
              <select data-roll-path="{{e.path}}" data-mod="{{e.mod}}">{{#each e.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{else}}<span class="die-value">{{e.value}}</span>{{/if}}
              <a data-action="reroll" data-path="{{e.path}}" data-tooltip="Перебросить (d{{e.sides}}: {{e.value}})"><i class="fa-solid fa-certificate"></i></a>
            {{/if}}
          </div>
          <div class="lp-text">{{#if e.title}}<b>{{e.title}}.</b> {{/if}}{{e.text}}{{#if e.detail}} <i>{{e.detail}}</i>{{/if}}</div>
        </div>
        {{/each}}
      </div>
      {{/each}}

      {{#if lifeChoices.length}}
      <div class="vd-panel">
        <h3>Выбор навыков</h3>
        {{#each lifeChoices}}
        <label class="choice-row">{{label}}
          <select data-field="choice.{{@index}}" data-path="{{path}}">
            <option value="">—</option>
            {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        {{/each}}
        <p class="hint">Если навык уже изучен — +1, если новый — сразу 2 (не выше 6 при создании).</p>
      </div>
      {{/if}}

      <div class="vd-panel">
        <h3>Что это даёт</h3>
        {{#if effectsSummary.length}}<ul class="effects-list">{{#each effectsSummary}}<li>{{this}}</li>{{/each}}</ul>
        {{else}}<p class="hint">Механических последствий нет — только история.</p>{{/if}}
      </div>
    {{/if}}
  {{/if}}

  {{!-- ============================== ПРОФЕССИЯ ========================= --}}
  {{#if is_profession}}
    <div class="card-grid small">
      {{#each professions}}
      <div class="pick-card{{#if selected}} selected{{/if}}{{#unless allowed}} disabled{{/unless}}" data-action="pickProfession" data-uuid="{{uuid}}"
        {{#unless allowed}}data-tooltip="Недоступно для выбранной расы"{{/unless}}>
        <header><img src="{{img}}" alt=""><h3>{{name}}</h3></header>
        <p class="meta">{{defining}} · Энергия {{vigor}}</p>
      </div>
      {{/each}}
    </div>
    {{#if profInfo}}
    <div class="vd-panel prof-info">
      <h3>{{profession.name}}</h3>
      <div class="desc">{{{profInfo.description}}}</div>
      <p><b>Определяющий навык:</b> {{profInfo.defining.name}} ({{profInfo.definingStat}}). {{profInfo.defining.effect}}</p>
      <p><b>Навыки:</b> {{profInfo.skills}}</p>
      {{#if profInfo.magic}}<p><b>Магические способности:</b> {{profInfo.magic}}</p>{{/if}}
      <p><b>Начальный капитал:</b> {{profInfo.money}} × 2d6 крон</p>
      <p><b>Древо:</b> {{#each profInfo.branches}}<span class="branch-line">{{name}}: {{abilities}}</span>{{/each}}</p>
      {{#each profInfo.choices as |c|}}
      <fieldset class="vd-fieldset">
        <legend>{{c.label}}</legend>
        <div class="check-grid">
          {{#each c.options}}
          <label class="check{{#if taken}} dim{{/if}}"><input type="checkbox" data-field="skillChoice.{{c.index}}.{{key}}" {{checked checked}} {{#if taken}}disabled{{/if}}> {{label}}</label>
          {{/each}}
        </div>
      </fieldset>
      {{/each}}
    </div>
    {{/if}}
  {{/if}}

  {{!-- ============================== ПАРАМЕТРЫ ========================= --}}
  {{#if is_stats}}
    <div class="vd-panel wizard-basics">
      <label>Способ
        <select data-field="statMode">
          <option value="points" {{#if (eq state.statMode "points")}}selected{{/if}}>Распределить очки</option>
          <option value="random" {{#if (eq state.statMode "random")}}selected{{/if}}>Случайно (9 × d10, 1–2 перебрасываются)</option>
        </select>
      </label>
      {{#if (eq state.statMode "points")}}
      <label>Уровень игры
        <select data-field="level">{{#each levels}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      <div class="budget{{#if remaining}} off{{/if}}">Осталось очков: <b>{{remaining}}</b> из {{budget}}</div>
      {{else}}
      <a class="roll-btn" data-action="rollStats"><i class="fa-solid fa-dice"></i> Бросить 9 × d10</a>
      {{/if}}
    </div>
    <div class="vd-panel">
      <table class="vd-table wizard-stats">
        <thead><tr><th class="name">Параметр</th><th>Основа</th><th>Раса</th><th>Путь</th><th>Итог</th></tr></thead>
        <tbody>
        {{#each statRows}}
        <tr>
          <td class="name">{{label}} <span class="dim">({{abbr}})</span></td>
          <td>
            {{#if (eq ../state.statMode "points")}}
              <input type="number" data-field="stats.{{key}}" value="{{base}}" min="1" max="10">
            {{else}}
              <select data-field="assign.{{key}}">
                <option value="">—</option>
                {{#each poolOptions}}<option value="{{index}}" {{#if selected}}selected{{/if}} {{#if used}}disabled{{/if}}>{{value}}</option>{{/each}}
              </select>
            {{/if}}
          </td>
          <td>{{vedmakSigned race}}</td>
          <td>{{vedmakSigned life}}</td>
          <td class="final">{{final}}</td>
        </tr>
        {{/each}}
        </tbody>
      </table>
      {{#if witcherNote}}<p class="hint">{{witcherNote}}</p>{{/if}}
      <div class="derived-grid">
        {{#each preview}}<div class="derived"><span class="abbr">{{label}}</span><span class="value">{{value}}</span></div>{{/each}}
      </div>
      <p class="hint">Значение параметра — от 1 до 10; расовые черты и мутации могут это преодолеть (стр. 47).</p>
    </div>
  {{/if}}

  {{!-- ================================ НАВЫКИ ========================== --}}
  {{#if is_skills}}
    <div class="vd-columns wizard-skills">
      <div class="vd-panel">
        <h3>Навыки профессии <span class="budget{{#if profRemaining}} off{{/if}}">осталось {{profRemaining}} из {{profBudget}}</span></h3>
        {{#if definingSkill}}
        <div class="wskill defining">
          <span class="name">{{definingSkill.name}} <span class="dim">({{definingSkill.stat}})</span></span>
          <input type="number" data-field="defining" value="{{definingSkill.value}}" min="1" max="{{cap}}">
          <span class="bonus"></span><span class="final">{{definingSkill.value}}</span>
        </div>
        {{/if}}
        {{#each profSkillRows}}
        <div class="wskill">
          <span class="name">{{label}} <span class="dim">({{stat}})</span>{{#if difficult}} <i class="fa-solid fa-asterisk difficult" data-tooltip="Сложный навык: 2 очка за уровень"></i>{{/if}}</span>
          <input type="number" data-field="profSkills.{{key}}" value="{{value}}" min="1" max="{{../cap}}">
          <span class="bonus">{{#if bonus}}+{{bonus}}{{/if}}{{#if native}}родной{{/if}}</span>
          <span class="final">{{final}}</span>
        </div>
        {{/each}}
        <p class="hint">44 очка на 11 навыков профессии, в каждый хотя бы 1, не больше 6. Сложные навыки стоят 2 очка за уровень (стр. 49).</p>
      </div>
      <div class="vd-panel">
        <h3>Освоенные навыки <span class="budget{{#if (lt pickupRemaining 0)}} off{{/if}}">осталось {{pickupRemaining}} из {{pickupBudget}} (Инт + Реа)</span></h3>
        {{#each pickupRows}}
        <div class="wskill{{#if value}} used{{/if}}">
          <span class="name">{{label}} <span class="dim">({{stat}})</span>{{#if difficult}} <i class="fa-solid fa-asterisk difficult"></i>{{/if}}</span>
          <input type="number" data-field="pickup.{{key}}" value="{{value}}" min="0" max="{{../cap}}">
          <span class="bonus">{{#if bonus}}+{{bonus}}{{/if}}{{#if native}}родной{{/if}}</span>
          <span class="final">{{final}}</span>
        </div>
        {{/each}}
        <p class="hint">Родной язык ({{nativeLabel}}) — 8 бесплатно. Бонусы родины и жизненного пути не поднимают навык выше 6.</p>
      </div>
    </div>
  {{/if}}

  {{!-- ================================ МАГИЯ =========================== --}}
  {{#if is_magic}}
    {{#each magicGroups as |g|}}
    <div class="vd-panel">
      <h3>{{g.label}}{{#unless g.auto}} <span class="budget{{#if (ne g.chosen g.count)}} off{{/if}}">выбрано {{g.chosen}} из {{g.count}}</span>{{/unless}}</h3>
      <div class="check-grid">
        {{#each g.items}}
        <label class="check"><input type="checkbox" data-field="magic" data-uuid="{{uuid}}" {{checked checked}} {{#if g.auto}}disabled{{/if}}>
          <img src="{{img}}" alt=""> {{name}}{{#if cost}} <span class="dim">({{cost}} Вын)</span>{{/if}}</label>
        {{else}}<p class="warning">В компендиумах нет подходящей магии.</p>
        {{/each}}
      </div>
    </div>
    {{else}}
    <div class="vd-panel"><p>У этой профессии нет стартовой магии.</p></div>
    {{/each}}
  {{/if}}

  {{!-- ============================== СНАРЯЖЕНИЕ ======================== --}}
  {{#if is_gear}}
    {{#if profession}}
    <div class="vd-panel">
      <h3>Начальный капитал</h3>
      <p>{{moneyBase}} × 2d6 крон (стр. 71).
        <a class="roll-btn" data-action="rollMoney"><i class="fa-solid fa-dice"></i> {{#if state.money}}Перебросить{{else}}Бросить{{/if}}</a>
        {{#if state.money}} 2d6 = {{state.money.dice.[0]}} + {{state.money.dice.[1]}} = {{state.money.sum}} → <b>{{state.money.total}} крон</b>{{/if}}
      </p>
    </div>
    {{#if gearOptions.length}}
    <div class="vd-panel">
      <h3>Снаряжение профессии <span class="budget{{#if (ne state.gear.length gearCount)}} off{{/if}}">выбрано {{state.gear.length}} из {{gearCount}}</span></h3>
      <div class="check-grid">
        {{#each gearOptions}}<label class="check"><input type="checkbox" data-field="gear" data-name="{{name}}" {{checked checked}}> {{name}}</label>{{/each}}
      </div>
    </div>
    {{/if}}
    {{#if gearFixed.length}}
    <div class="vd-panel"><h3>Особое снаряжение</h3><p>{{#each gearFixed}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
    {{/if}}
    {{#if lifeItems.length}}
    <div class="vd-panel"><h3>Из жизненного пути</h3><p>{{#each lifeItems}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></div>
    {{/if}}
    <p class="hint">Предметы ищутся по названию в компендиумах; если их там нет, создаётся простое снаряжение с этим названием. Докупить остальное можно на оставшиеся кроны.</p>
    {{/if}}
  {{/if}}

  {{!-- ================================ ИТОГ ============================ --}}
  {{#if is_summary}}
    <div class="vd-panel summary">
      <h3>{{summary.name}}</h3>
      <p>{{summary.race}} · {{summary.profession}} · {{summary.gender}} · {{summary.age}} лет · {{summary.homeland}}</p>
      <div class="derived-grid nine">
        {{#each summary.stats}}<div class="derived"><span class="abbr">{{abbr}}</span><span class="value">{{value}}</span></div>{{/each}}
      </div>
      <p><b>Определяющий навык:</b> {{summary.defining}}</p>
      <p><b>Навыки:</b> {{summary.skills}}</p>
      {{#if summary.magic}}<p><b>Магия:</b> {{summary.magic}}</p>{{/if}}
      <p><b>Кроны:</b> {{summary.money}}</p>
      <p><b>Снаряжение:</b> {{summary.gear}}</p>
      {{#if summary.effects.length}}<p><b>Жизненный путь:</b> {{#each summary.effects}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</p>{{/if}}
    </div>
  {{/if}}
  </div>

  <footer class="wizard-footer">
    {{#if problem}}<span class="problem"><i class="fa-solid fa-triangle-exclamation"></i> {{problem}}</span>{{else}}<span class="ok"><i class="fa-solid fa-check"></i> Шаг заполнен</span>{{/if}}
    <div class="buttons">
      {{#unless isFirst}}<button type="button" data-action="prev"><i class="fa-solid fa-arrow-left"></i> Назад</button>{{/unless}}
      {{#if isLast}}
        <button type="button" class="primary" data-action="apply"><i class="fa-solid fa-check"></i> Создать персонажа</button>
      {{else}}
        <button type="button" class="primary" data-action="next">Далее <i class="fa-solid fa-arrow-right"></i></button>
      {{/if}}
    </div>
  </footer>
</div>

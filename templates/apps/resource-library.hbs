{{!-- Библиотека ресурсов (PLAN 4.201) в облике окон королевства (PLAN 4.238): шапка из кожи, поиск и разделы — кованой
     полосой, разделы — заголовками листа, ресурсы — плашками шлифованного металла с картинкой в кольце. Классы rl-* — для кода --}}
<div class="rs rl">
  <header class="rl-head">
    <span class="rs-sock sm rl-sock"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></span>
    <div class="rl-head-t"><h2>Библиотека ресурсов</h2><div class="rl-sub"><span>{{#if town}}склад «{{town.name}}»{{else}}перетащите на лист поселения{{/if}}</span></div></div>
    {{#if gm}}<button type="button" class="rs-btn" data-action="create" data-tooltip="Свой ресурс — предмет «Ресурс»: имя, значок, цена, раздел">Свой ресурс</button>{{/if}}
  </header>
  <div class="rl-bar">
    <input type="search" class="rl-search" value="{{query}}" placeholder="Найти ресурс…" aria-label="Поиск">
    <span class="rl-hint">{{#if town}}«+» — на склад «{{town.name}}»; или перетащите на лист любого поселения{{else}}Перетащите ресурс на лист поселения — склад начнёт его учитывать{{/if}}</span>
  </div>
  <nav class="rl-tabs">
    {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="category" data-key="{{key}}">{{label}} <small>{{count}}</small></a>{{/each}}
  </nav>
  <div class="rl-list">
    {{#each groups}}
    <section class="rl-group">
      <h3>{{label}}</h3>
      <ul class="rl-items">
        {{#each items}}
        <li class="rl-item {{#if have}}have{{/if}} {{#if custom}}custom{{/if}}" draggable="true" data-name="{{name}}" data-search="{{search}}" {{#if uuid}}data-uuid="{{uuid}}"{{/if}}
          data-tooltip="{{name}}{{#if hint}} — {{hint}}{{/if}}{{#if have}} · уже на складе{{/if}}">
          <span class="rl-img"><img src="{{img}}" alt=""></span>
          <span class="rl-text"><b>{{name}}</b><small>{{price}}{{#if custom}} · свой{{/if}}</small></span>
          {{#if have}}<i class="fa-solid fa-check rl-have" aria-label="На складе"></i>
          {{else}}<a class="rl-add" data-action="add" aria-label="На склад"><i class="fa-solid fa-plus"></i></a>{{/if}}
          {{#if custom}}{{#if @root.gm}}<a class="rl-edit" data-action="openItem" aria-label="Править"><i class="fa-solid fa-pen"></i></a>{{/if}}{{/if}}
        </li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </div>
</div>

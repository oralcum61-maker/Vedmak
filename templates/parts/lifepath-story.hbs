{{!-- Жизненный путь для чтения — «летописью» (lifepathStory в module/character/lifepath.mjs).
      Правка идёт прежними карточками (lifepath-cards.hbs). Контекст: story = {blocks, pending}. --}}
<div class="lp-story">
  {{#each story.blocks as |b|}}
  <section class="lp-block {{b.kind}}">
    <div class="group-head">
      <span class="bronze-tag">{{b.title}}</span>
      <span class="rule"></span>
      {{#if b.subtitle}}<span class="lp-sub">{{b.subtitle}}</span>{{/if}}
    </div>

    {{#if (eq b.kind "facts")}}
      {{#if b.featured.length}}
      <div class="lp-featured">
        {{#each b.featured as |f|}}
        <div class="lp-feature">
          <span class="lp-cap">{{f.label}}</span>
          <h4 class="lp-head">{{f.head}}</h4>
          {{#if f.body}}<p class="lp-body">{{f.body}}</p>{{/if}}
          {{#if f.detail}}<p class="lp-gold">{{f.detail}}</p>{{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{#each b.facts as |f|}}
      <div class="lp-fact">
        <span class="lp-cap">{{f.label}}</span>
        <p><b class="lp-head">{{f.head}}</b>{{#if f.body}} <span class="lp-body">{{f.body}}</span>{{/if}}{{#if f.detail}} <span class="lp-gold">{{f.detail}}</span>{{/if}}</p>
      </div>
      {{/each}}
    {{/if}}

    {{#if (eq b.kind "siblings")}}
      {{#if b.people.length}}
      <ul class="lp-people">
        {{#each b.people as |p|}}
        <li><b>{{p.who}}</b><span class="lp-person">{{#each p.meta}}<span>{{this}}</span>{{/each}}</span></li>
        {{/each}}
      </ul>
      {{/if}}
    {{/if}}

    {{#if (eq b.kind "chronicle")}}
      <ol class="lp-timeline">
        {{#each b.eras as |era|}}
        <li class="lp-era">
          <span class="lp-age"{{#if era.hint}} data-tooltip="{{era.hint}}"{{/if}}><b>{{era.age}}</b>{{#if era.unit}}<small>{{era.unit}}</small>{{/if}}</span>
          <div class="lp-era-body">
            {{#if era.sub}}<span class="lp-risk-note">{{era.sub}}</span>{{/if}}
            {{#each era.facets as |f|}}
            <div class="lp-event{{#if f.quiet}} quiet{{/if}}">
              <p class="lp-event-head">{{#if f.title}}<span class="lp-cap">{{f.title}}</span>{{/if}}<b>{{f.head}}</b></p>
              {{#if f.meta.length}}
              <p class="lp-meta">{{#each f.meta}}<span><i>{{k}}:</i> {{v}}</span>{{/each}}</p>
              {{/if}}
              {{#each f.notes}}<p class="lp-body">{{this}}</p>{{/each}}
            </div>
            {{/each}}
          </div>
        </li>
        {{/each}}
      </ol>
    {{/if}}

    {{#if (eq b.kind "traits")}}
      <div class="lp-traits">
        {{#each b.groups as |g|}}
        <dl>
          <dt class="lp-cap">{{g.title}}</dt>
          {{#each g.items}}<dd><i>{{k}}</i> {{v}}</dd>{{/each}}
        </dl>
        {{/each}}
      </div>
    {{/if}}
  </section>
  {{/each}}

  {{#if story.pending}}
  <div class="lp-next-bar">
    <span>Дальше: <b>{{story.pending.label}}</b></span>
    <span class="grow"></span>
    <a class="roll-btn" data-action="{{story.pending.action}}" data-tooltip="Бросок уйдёт в чат">Бросить d{{story.pending.sides}}</a>
    {{#if story.pending.sectionAction}}
    <a class="roll-btn" data-action="{{story.pending.sectionAction}}" data-tooltip="Бросить раздел «{{story.pending.cardTitle}}» — каждый бросок в чат">Раздел</a>
    {{/if}}
    {{#if story.pending.options}}<select class="lp-choose" data-roll-path="{{story.pending.path}}" data-mod="{{story.pending.mod}}" data-tooltip="Не бросать — выбрать результат самому">
          <option value="">или выбрать…</option>{{#each story.pending.options}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{/if}}
  </div>
  {{/if}}
</div>

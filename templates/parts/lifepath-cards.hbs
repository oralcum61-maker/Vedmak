{{!-- Жизненный путь карточками — общий для мастера создания и «Дневника». Контекст: cards (lifepathCards).
      Строка: подпись, результат; если можно править — кость (переброс), список (свой результат) и перо (своё описание:
      показывается вместо текста книги). Путь бросается по шагу: следующий бросок — строкой с кнопкой в конце своей
      карточки (card.pending); его можно и выбрать из списка, не бросая. --}}
{{#*inline "lpValue"}}
  {{#if note}}
  <span class="lp-v lp-own" data-tooltip="Своё описание. По книге: {{original}}">{{note}}{{#if detail}} <i class="lp-detail">{{detail}}</i>{{/if}}</span>
  {{else}}
  <span class="lp-v">{{#if title}}<b>{{title}}.</b> {{/if}}{{text}}{{#if detail}} <i class="lp-detail">{{detail}}</i>{{/if}}</span>
  {{/if}}
  {{#if editable}}
  <span class="lp-ctl">
    {{#if options}}
    <select data-roll-path="{{path}}" data-mod="{{mod}}" data-tooltip="Выбрать результат">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    {{/if}}
    <a class="lp-die" data-action="{{action}}" data-path="{{path}}" data-tooltip="Перебросить (d{{sides}})">{{value}}</a>
    {{#if noteAction}}<a class="lp-pen{{#if note}} active{{/if}}" data-action="{{noteAction}}" data-path="{{path}}"
      data-tooltip="{{#if note}}Поправить своё описание или вернуть текст книги{{else}}Описать своими словами{{/if}}"><i class="fa-solid fa-feather"></i></a>{{/if}}
  </span>
  {{/if}}
{{/inline}}

<div class="lp-cards">
  {{#each cards as |c|}}
  <article class="lp-card {{c.cls}}">
    <header class="lp-card-head">
      <i class="fa-solid {{c.icon}}"></i>
      <h4>{{c.title}}</h4>
      {{#if c.riskOptions}}
      <select class="lp-risk" data-lp-risk="{{c.decade}}" data-tooltip="Поведение в это десятилетие: от него шанс опасности (стр. 241)">
        {{#each c.riskOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      {{else}}{{#if c.subtitle}}<span class="lp-sub">{{c.subtitle}}</span>{{/if}}{{/if}}
    </header>

    {{#if c.grid}}
    <div class="lp-grid">
      {{#each c.rows as |r|}}
      <div class="lp-cell"><span class="lp-k">{{r.label}}</span>{{> lpValue r}}</div>
      {{/each}}
    </div>
    {{else}}
      {{#each c.rows as |r|}}
      <div class="lp-row{{#if r.static}} static{{/if}}"><span class="lp-k">{{r.label}}</span>{{> lpValue r}}</div>
      {{/each}}
      {{#if c.table}}
      <table class="lp-table">
        <thead><tr><th></th>{{#each c.table.cols}}<th>{{this}}</th>{{/each}}</tr></thead>
        <tbody>
        {{#each c.table.rows as |row|}}
          <tr><td class="n">{{row.n}}</td>{{#each row.cells as |cell|}}<td>{{> lpValue cell}}</td>{{/each}}</tr>
        {{/each}}
        </tbody>
      </table>
      {{/if}}
    {{/if}}

    {{#if c.pending}}
    <div class="lp-row lp-pending">
      <span class="lp-k">{{c.pending.label}}</span>
      <span class="lp-ctl">{{#if c.pending.action}}<a class="roll-btn lp-next" data-action="{{c.pending.action}}" data-tooltip="Бросок уйдёт в чат">
        Бросить d{{c.pending.sides}}</a>
        <a class="roll-btn lp-next" data-action="{{c.pending.sectionAction}}" data-tooltip="Бросить раздел «{{c.pending.cardTitle}}» по очереди — каждый бросок в чат">
        Раздел</a>
        {{#if c.pending.options}}<select class="lp-choose" data-roll-path="{{c.pending.path}}" data-mod="{{c.pending.mod}}" data-tooltip="Не бросать — выбрать результат самому">
          <option value="">или выбрать…</option>{{#each c.pending.options}}<option value="{{value}}">{{label}}</option>{{/each}}</select>{{/if}}{{else}}<span class="lp-v">ещё не брошено</span>{{/if}}</span>
    </div>
    {{/if}}
  </article>
  {{/each}}
</div>

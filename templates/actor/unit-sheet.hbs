{{!-- Лист отряда (PLAN 4.187, 4.198): пластины, «Отряд» (командир, содержание, оружие и броня), «Обучение», «Летопись» --}}
<div class="sv ar">
  <header class="sv-head">
    <span class="sv-sock big"><img class="sv-arms" src="{{actor.img}}" alt="" data-edit="img" data-tooltip="Знамя отряда"></span>
    <div class="sv-title">
      {{#if editable}}<input class="sv-name" type="text" name="name" value="{{actor.name}}" aria-label="Название">
      {{else}}<h1 class="sv-name">{{actor.name}}</h1>{{/if}}
      <div class="sv-cal">
        {{#if gm}}<span class="sv-week"><select name="system.kind" aria-label="Род войск">{{#each kinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></span>
        {{else}}<span class="sv-week">{{kind.label}}</span>{{/if}}
        <i></i><span data-tooltip="{{origin.hint}}">{{origin.label}}</span>
        {{#if home}}<i></i><a class="ar-home" data-action="openActor" data-uuid="{{home.uuid}}">{{home.name}}</a>{{/if}}
      </div>
    </div>
    {{#if commander}}
    <div class="ar-cmdr">
      <span class="sv-sock sm"><img src="{{commander.img}}" alt=""></span>
      <div class="ar-cmdr-t"><span>Командир</span><a data-action="openActor" data-uuid="{{commander.uuid}}"><b>{{commander.name}}</b></a>
        <em data-tooltip="(Эмпатия + Лидерство) / 3">сила +{{commander.bonus}}</em></div>
      {{#if editable}}<a class="sv-demolish" data-action="clearCommander" data-tooltip="Снять командира">×</a>{{/if}}
    </div>
    {{else}}
    <div class="ar-cmdr empty" data-tooltip="Перетащите на лист персонажа: его Эмпатия и Лидерство прибавят силы отряду">
      <span class="sv-sock sm"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
      <div class="ar-cmdr-t"><span>Командир</span><b>Нет командира</b><em>перетащите персонажа</em></div>
    </div>
    {{/if}}
    {{#if gm}}<button type="button" class="sv-next" data-action="battle" data-tooltip="Открыть окно битвы с этим отрядом">В бой</button>{{/if}}
  </header>

  <section class="sv-plaques ar-plaques">
    <div class="sv-plaque">
      <span class="sv-medal">{{#if gm}}<input type="number" name="system.soldiers" value="{{sys.soldiers}}" min="0" step="1" class="big" aria-label="Бойцы">{{else}}<b class="big">{{sys.soldiers}}</b>{{/if}}</span>
      <span class="cap">Бойцы</span>
      <small>{{kind.label}}{{#if sys.routed}} · <span class="warn">бежали</span>{{/if}}</small>
    </div>
    <div class="sv-plaque" data-tooltip="Тренировка идёт каждую неделю поселения, пока отряд тренируется и есть плац или казарма">
      <span class="sv-medal"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
      <span class="cap">Выучка</span>
      <b class="ar-label">{{training.label}}</b>
      <span class="sv-pips">{{#each training.pips}}<i class="{{#if on}}on{{/if}}" data-tooltip="{{label}}"></i>{{/each}}</span>
      <small>{{training.progress}}</small>
      {{#if editable}}<div class="sv-mini-acts"><a data-action="drill" class="{{#if sys.drilling}}on{{/if}}">{{#if sys.drilling}}На плацу ✓{{else}}На плац{{/if}}</a></div>{{/if}}
      {{#if sys.drilling}}{{#unless training.canDrill}}<small class="warn">нет плаца или казармы</small>{{/unless}}{{/if}}
    </div>
    <div class="sv-plaque" data-tooltip="Опыт: неделя на плацу +1, раунд битвы +2, победа +5. Звание открывает ступени обучения">
      <span class="sv-ring" style="--arc: {{rank.arc}}deg"><b>{{rank.xp}}</b></span>
      <span class="cap">Опыт</span>
      <b class="ar-label">{{rank.label}}</b>
      <small>{{#if gm}}<input type="number" name="system.xp" value="{{sys.xp}}" min="0" step="1" class="ar-small" aria-label="Опыт">{{else}}{{rank.xp}}{{/if}} · {{rank.next}}</small>
    </div>
    <div class="sv-plaque sv-approval tone-{{morale.tone}}">
      <span class="sv-ring" style="--arc: {{morale.arc}}deg"><b>{{morale.value}}</b></span>
      <div class="sv-approval-text">
        <span class="cap">Боевой дух</span>
        <small>{{morale.note}}</small>
        {{#if gm}}<input type="number" name="system.morale" value="{{sys.morale}}" min="0" max="10" step="1" class="ar-small">{{/if}}
      </div>
    </div>
    <div class="sv-plaque" data-tooltip="{{power.parts}}">
      <span class="sv-medal"><b class="big">{{power.total}}</b></span>
      <span class="cap">Сила</span>
      <small>d10 + сила в каждом раунде</small>
    </div>
  </section>

  <nav class="sv-tabs">
    {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="unitTab" data-tab="{{id}}">{{label}}</a>{{/each}}
  </nav>

  <div class="sv-scroll">
  {{#if (eq tab "unit")}}
    <section class="sv-block">
      <h3><span class="sv-tag">Снаряжение</span><small>{{kind.label}} · со склада родного поселения, на каждого бойца</small></h3>
      <div class="ar-gear">
        {{#each gear}}
        <div class="ar-track">
          <header><b>{{label}}</b><span>{{current}}</span></header>
          <ol class="ar-tiers">
            {{#each tiers}}<li class="{{#if on}}on{{/if}}{{#if current}} current{{/if}}{{#if isNext}} next{{/if}}">{{#if icon}}<svg class="ar-tier-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="{{icon}}"></path></svg>{{/if}}<b>{{label}}</b>
              <span>{{#if power}}сила +{{power}}{{/if}}{{#if saves}}{{#if power}} · {{/if}}<span data-tooltip="Кубики 1d2−1: каждый спасает 0 или 1 бойца в раунд; их больше у большого отряда">спасает {{saves}}d2−{{saves}}</span>{{/if}}{{#unless power}}{{#unless saves}}—{{/unless}}{{/unless}}</span><small>{{gear}}</small>{{#if isNext}}<span class="ar-cost {{#if ../ok}}ok{{else}}bad{{/if}}"><span class="sv-bar"><i style="width: {{../costPct}}%"></i></span><small>{{../costText}}</small></span>{{/if}}</li>{{/each}}
          </ol>
          {{#if next}}
          <div class="ar-track-foot">
            <span class="ar-track-cost">до «{{next}}»: {{#each cost}}<span class="bl-chip xs {{#if short}}short{{/if}}" data-tooltip="{{name}}{{#if short}} — на складе не хватает{{/if}}"><img src="{{img}}" alt=""><b>{{qty}}</b></span>{{/each}}</span>
            {{#if @root.editable}}<a class="sv-btn {{#unless ok}}off{{/unless}}" data-action="equip" data-track="{{track}}">Снарядить</a>{{/if}}
          </div>
          {{else}}<small class="ar-track-max">лучше не бывает</small>{{/if}}
        </div>
        {{/each}}
      </div>
    </section>

    <section class="sv-block ar-campaign">
      <h3><span class="sv-tag">Поход</span><small>{{#if campaign.on}}в походе{{else}}дома{{/if}}</small></h3>
      <div class="ar-camp">
        {{#if campaign.on}}
        <span><b>{{campaign.supplies}}</b> еды с собой — на {{campaign.weeks}} нед.{{#if campaign.siege}} · <span class="warn">осаждает «{{campaign.siege}}»</span>{{/if}}</span>
        {{#if editable}}{{#if campaign.siege}}<a class="sv-btn" data-action="liftSiege">Снять осаду</a>{{else}}<a class="sv-btn" data-action="besiege">Осадить…</a>{{/if}}
        <a class="sv-btn" data-action="returnHome">Домой</a>{{/if}}
        {{else}}
        <span class="sv-hint">Дома отряд ест со склада поселения и тренируется. В походе — ест взятые припасы, может осадить чужое поселение.</span>
        {{#if editable}}<a class="sv-btn" data-action="march">В поход…</a>{{/if}}
        {{/if}}
      </div>
    </section>

    <section class="sv-block">
      <h3><span class="sv-tag">Содержание</span><small>в неделю</small></h3>
      <ul class="sv-parts">
        <li><span>Еда со склада поселения</span><b>{{upkeep.food}}</b></li>
        {{#if upkeep.pay}}<li><span>Плата наёмникам, Богатство</span><b>{{upkeep.pay}}</b></li>{{/if}}
        {{#unless home}}<li class="warn"><span>Нет родного поселения — кормить и тренировать некому</span></li>{{/unless}}
      </ul>
    </section>
    {{#if editable}}<div class="ar-foot"><a class="sv-btn" data-action="disband">Распустить отряд</a></div>{{/if}}
  {{/if}}

  {{#if (eq tab "training")}}
    <ol class="ar-ranks" aria-label="Звания">
      {{#each rank.list}}<li class="{{#if on}}on{{/if}}{{#if now}} now{{/if}}"><span class="ar-gem"></span><b>{{label}}</b>
        {{#if now}}<span class="sv-bar"><i style="width: {{@root.rank.pct}}%"></i></span><small>{{@root.rank.xp}} опыта · {{@root.rank.next}}</small>
        {{else}}<small>с {{xp}} опыта{{#if power}} · сила +{{power}}{{/if}}</small>{{/if}}</li>{{/each}}
    </ol>
    <div class="bl-tree-bar">
      <span class="sv-hint">Ступень — цена со склада родного поселения сразу, недели — на плацу (отряд должен тренироваться). Звание, оружие и броня открывают новые ступени.</span>
      {{#if gm}}<a class="sv-btn {{#if treeEdit}}on{{/if}}" data-action="treeEdit">{{#if treeEdit}}Готово{{else}}Править дерево{{/if}}</a>{{/if}}
    </div>
    <div class="bl-branches">
      {{#each tree as |br|}}
      <section class="bl-branch">
        <header>
          <span class="bl-branch-icon"><i class="fa-solid {{br.icon}}"></i></span>
          {{#if @root.treeEdit}}
          <input type="text" name="{{br.path}}.name" value="{{br.name}}" aria-label="Название ветки">
          <input type="text" name="{{br.path}}.icon" value="{{br.icon}}" class="bl-icon-in" data-tooltip="Значок Font Awesome" aria-label="Значок">
          <a class="bl-x" data-action="treeDel" data-path="system.branches" data-index="{{br.index}}" data-tooltip="Убрать ветку"><i class="fa-solid fa-trash"></i></a>
          {{else}}<b>{{br.name}}</b><small>{{br.done}} из {{br.total}}</small>{{/if}}
        </header>
        <ol class="bl-nodes">
          {{#each br.nodes as |nd|}}
          <li class="bl-node {{nd.state}}" data-node="{{nd.id}}">
            {{#if @root.treeEdit}}
            <div class="bl-node-edit">
              <input type="text" name="{{nd.path}}.name" value="{{nd.name}}" class="bl-node-name-in" aria-label="Название ступени">
              <div class="bl-node-nums ar-node-req">
                <label data-tooltip="Нужное звание"><select name="{{nd.path}}.rank">{{selectOptions @root.rankOptions selected=nd.rank}}</select></label>
                <label data-tooltip="Нужное оружие"><select name="{{nd.path}}.weapons">{{selectOptions @root.weaponOptions selected=nd.weapons}}</select></label>
                <label data-tooltip="Нужная броня"><select name="{{nd.path}}.armor">{{selectOptions @root.armorOptions selected=nd.armor}}</select></label>
              </div>
              <div class="bl-node-nums">
                <label data-tooltip="Недель на плацу; 0 — сразу">нед. <input type="number" name="{{nd.path}}.weeks" value="{{nd.weeks}}" min="0" step="1"></label>
                <a class="bl-x" data-action="treeDel" data-path="system.branches.{{br.index}}.nodes" data-index="{{nd.index}}" data-tooltip="Убрать ступень"><i class="fa-solid fa-trash"></i></a>
              </div>
              <textarea name="{{nd.path}}.description" rows="2" placeholder="Что это">{{nd.description}}</textarea>
              <div class="bl-node-list">
                <span class="cap">Цена</span>
                {{#each nd.cost}}<span class="bl-cost-row">
                  <input type="text" name="{{path}}.resource" value="{{resource}}" list="ar-res-{{@root.actor.id}}" placeholder="Ресурс">
                  <input type="number" name="{{path}}.qty" value="{{qty}}" min="0" step="any">
                  <a data-action="treeDel" data-path="{{nd.path}}.cost" data-index="{{index}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a></span>{{/each}}
                <a class="bl-plus" data-action="treeAdd" data-kind="cost" data-path="{{nd.path}}.cost"><i class="fa-solid fa-plus"></i> ресурс</a>
              </div>
              <div class="bl-node-list">
                <span class="cap">Эффекты</span>
                {{#each nd.effects}}
                <div class="bl-eff-row">
                  <select name="{{path}}.type">{{selectOptions @root.effectTypes selected=type}}</select>
                  {{#if vs}}<select name="{{path}}.kind">{{selectOptions @root.kindOptions selected=kind}}</select>{{/if}}
                  {{#if ter}}<select name="{{path}}.terrain">{{selectOptions @root.terrainOptions selected=terrain}}</select>{{/if}}
                  {{#if dice}}<label class="bl-eff-val" data-tooltip="Бросок — 1 раз у новобранцев и обстрелянных, 2 — у ветеранов и закалённых, 3 — у элиты"><input type="text" name="{{path}}.formula" value="{{diceFormula}}" class="bl-formula"></label>
                  {{else}}<label class="bl-eff-val"><input type="number" name="{{path}}.value" value="{{value}}" step="any"></label>{{/if}}
                  <a data-action="treeDel" data-path="{{nd.path}}.effects" data-index="{{index}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a>
                </div>
                {{/each}}
                <a class="bl-plus" data-action="treeAdd" data-kind="effect" data-path="{{nd.path}}.effects"><i class="fa-solid fa-plus"></i> эффект</a>
              </div>
            </div>
            {{else}}
            <div class="bl-node-head">
              <b>{{nd.name}}</b>
              {{#if @root.gm}}<a class="bl-grant" data-action="grant" data-tooltip="{{#if (eq nd.state "bought")}}Забрать ступень{{else}}Дать даром{{/if}}"><i class="fa-solid {{#if (eq nd.state "bought")}}fa-rotate-left{{else}}fa-gift{{/if}}"></i></a>{{/if}}
            </div>
            {{#if nd.needs}}<small class="ar-needs">{{nd.needs}}</small>{{/if}}
            {{#if nd.description}}<p class="bl-node-desc">{{nd.description}}</p>{{/if}}
            <ul class="bl-effects">{{#each nd.effects}}<li>{{label}}</li>{{else}}<li class="none">без эффекта</li>{{/each}}</ul>
            <div class="bl-node-foot">
              {{#if (eq nd.state "bought")}}<span class="bl-done"><i class="fa-solid fa-check"></i> освоена</span>
              {{else if (eq nd.state "working")}}
                <span class="bl-work"><span class="sv-bar"><i style="width: {{nd.progress.pct}}%"></i></span><small>{{nd.progress.done}} из {{nd.progress.weeks}} нед. на плацу{{#if nd.progress.stalled}} — <span class="warn">отряд не тренируется</span>{{/if}}</small></span>
                {{#if @root.editable}}<a class="bl-cancel" data-action="stopTraining" data-tooltip="Бросить (потраченное не вернётся)"><i class="fa-solid fa-xmark"></i></a>{{/if}}
              {{else}}
                <span class="bl-cost">{{#each nd.cost}}<span class="bl-chip xs {{#if short}}short{{/if}}" data-tooltip="{{resource}}"><img src="{{img}}" alt=""><b>{{qty}}</b></span>{{else}}<span class="bl-none">даром</span>{{/each}}</span>
                <small class="bl-weeks"><i class="fa-solid fa-person-running"></i> {{#if nd.weeks}}{{nd.weeks}} нед.{{else}}сразу{{/if}}</small>
                {{#if (eq nd.state "open")}}{{#if @root.editable}}<a class="sv-btn bl-take" data-action="train">Учить</a>{{/if}}
                {{else}}<small class="bl-why"><i class="fa-solid fa-lock"></i> {{nd.why}}</small>{{/if}}
              {{/if}}
            </div>
            {{/if}}
          </li>
          {{/each}}
          {{#if @root.treeEdit}}<li class="bl-node add"><a data-action="treeAdd" data-kind="node" data-path="system.branches.{{br.index}}.nodes"><i class="fa-solid fa-plus"></i> ступень</a></li>{{/if}}
        </ol>
      </section>
      {{/each}}
      {{#if treeEdit}}<section class="bl-branch add"><a data-action="treeAdd" data-kind="branch"><i class="fa-solid fa-plus"></i><span>Ветка</span></a></section>{{/if}}
    </div>
    {{#if treeEdit}}<datalist id="ar-res-{{actor.id}}">{{#each resourceNames}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
  {{/if}}

  {{#if (eq tab "notes")}}
    <section class="sv-block sv-notes">
      {{#if editable}}{{formInput systemFields.description value=sys.description enriched=enrichedDescription toggled=true}}
      {{else}}{{{enrichedDescription}}}{{/if}}
    </section>
  {{/if}}
  </div>
</div>

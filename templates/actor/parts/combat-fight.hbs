{{!-- Обычный бой: чем бью, чем отвечаю, что со мной. Общий для персонажа и чудовища. --}}
  <section class="combat-block weapons">
    <div class="group-head">
      <span class="bronze-tag">ЧЕМ БЬЮ</span>
      <span class="rule"></span>
      <span class="hint-inline">Shift — без окна</span>
    </div>

    {{#each attacks as |a|}}
    <div class="atk-row{{#if a.equipped}} ready{{else}} off{{/if}}" data-item-id="{{a.itemId}}">
      <span class="atk-frame"><img src="{{a.img}}" class="atk-icon" alt=""></span>
      <span class="atk-who">
        <span class="atk-name">
          {{#if a.itemId}}<a data-action="itemEdit">{{a.label}}</a>{{else}}{{a.label}}{{/if}}
          {{#if a.oil}}<span class="tag oil">{{a.oil}}</span>{{/if}}
          {{#if a.attackSpeed}}<span class="tag">СА {{a.attackSpeed}}</span>{{/if}}
        </span>
        <span class="atk-about">
          {{#unless a.equipped}}<span class="off-note">не в руках</span> · {{/unless}}
          {{a.skillLabel}}
          {{#if a.silver}} · <span class="silver">{{a.silver}}</span>{{/if}}
          {{#if a.nonLethal}} · несмертельный{{/if}}
          {{#if a.range}} · дистанция {{a.range}} м{{/if}}
          {{#if a.traits}} · {{a.traits}}{{/if}}
        </span>
        {{#if a.reliability}}
        <span class="atk-rel" data-tooltip="Надёжность: падает при блоке и на критическом провале">
          {{vedmakNotches a.reliability.value a.reliability.max}}
          <span class="cap">надёжность {{a.reliability.value}} / {{a.reliability.max}}</span>
        </span>
        {{/if}}
      </span>
      <span class="atk-base">{{> "systems/vedmak/templates/actor/parts/medal.hbs" value=a.base cls="md"}}<em>основа</em></span>
      <span class="atk-dmg">
        <b>{{a.damage}}</b>
        <em>{{a.damageLabel}}</em>
      </span>
      {{#if a.equipped}}
      <button type="button" class="atk-go" data-action="attack" data-kind="{{a.kind}}" data-item-id="{{a.itemId}}"
              data-tooltip="Окно атаки (Shift — сразу)">
        {{#if a.isRanged}}Выстрел{{else}}Атака{{/if}}
      </button>
      {{else}}
      <a class="atk-go quiet" data-action="itemToggleEquip" data-item-id="{{a.itemId}}" data-tooltip="Взять в руки">В руки</a>
      {{/if}}
    </div>
    {{/each}}

    {{#if adrenalineRule}}
    <label class="adrenaline" data-tooltip="Кость адреналина: +1d6 урона за −10 Вын, максимум — Телосложение">
      <span>Адреналин: кость +1d6 к урону за −10 Вын</span>
      <input type="number" name="system.adrenaline.value" value="{{system.adrenaline.value}}" min="0">
      <span class="cap">из {{system.stats.body.effective}}</span>
    </label>
    {{/if}}
  </section>

  <div class="combat-cols">

    <section class="combat-block">
      <div class="group-head"><span class="bronze-tag">ЧЕМ ОТВЕЧАЮ</span><span class="rule"></span></div>

      <div class="def-grid">
        {{#each defenses}}
        <a class="def-row rollable" data-action="rollSkill" data-skill="{{key}}" data-tooltip="Проверка навыка (Shift — без окна)">
          <span class="stamp"><b>{{base}}</b></span>
          <span class="who">
            <span class="name">{{label}}</span>
            <span class="about">{{about}}</span>
          </span>
        </a>
        {{/each}}
      </div>

      <div class="save-grid">
        <a class="save rollable" data-action="stunSave" data-tooltip="d10 меньше Уст — иначе дезориентация">
          <span class="sv"><span class="name">Испытание Уст</span><em>успех на d10 {{vedmakSaveRange system.derived.stun}}</em></span>
          <span class="thr"><b>{{system.derived.stun}}</b><span class="cap">порог</span></span>
        </a>
        <a class="save bad rollable{{#if system.derived.dying}} alert{{/if}}" data-action="deathSave"
           data-tooltip="d10 меньше Уст − накопленный штраф (Удача поднимает порог)">
          <span class="sv"><span class="name">Против смерти</span><em>успех на d10 {{vedmakSaveRange (vedmakSub system.derived.stun system.deathSaves.penalty)}}</em></span>
          <span class="thr"><b>{{vedmakSub system.derived.stun system.deathSaves.penalty}}</b><span class="cap">порог</span></span>
        </a>
      </div>
      {{#if system.deathSaves.penalty}}
      <p class="hint">Порог против смерти падает на 1 за каждое испытание: пройдено {{system.deathSaves.penalty}}.</p>
      {{/if}}

      <div class="group-head"><span class="glabel">ХОД</span><span class="rule"></span></div>
      <div class="turn-row">
        <button type="button" class="turn-btn" data-action="restTurn" data-tooltip="Полный ход: восстановить Вын">
          Отдых (ход) <b>+{{system.derived.rec}}</b>
        </button>
        <button type="button" class="turn-btn" data-action="aimTurn" data-tooltip="Полный ход: +1 к следующей атаке по выбранной цели за ход, до +3. Любая атака сбрасывает">
          Прицелиться{{#if aimRounds}} <b>+{{aimRounds}}</b>{{/if}}
        </button>
        <button type="button" class="turn-btn" data-action="restDays" data-tooltip="Дни отдыха: ПЗ, Вын, заживление ран">
          Дни отдыха
        </button>
        <button type="button" class="turn-btn" data-action="manualDamage" data-tooltip="Падение, бомба, ловушка, огонь">
          Урон без атаки
        </button>
        <button type="button" class="turn-btn quiet" data-action="controlCheck" data-tooltip="Реа + Верховая езда / Мореходство">
          Управление
        </button>
        <button type="button" class="turn-btn quiet" data-action="ram" data-tooltip="Таран скакуном или транспортом">
          Таран
        </button>
      </div>
    </section>

    <section class="combat-block">
      <div class="group-head">
        <span class="bronze-tag">БРОНЯ</span>
        <span class="rule"></span>
        {{#if system.derived.encumbrance}}<span class="bad-inline">скованность −{{system.derived.encumbrance}}</span>{{/if}}
      </div>

      {{#if armorDoll}}
      <div class="armor-doll">
        <div class="doll-col">
          {{#each armorDoll.left}}
          <div class="armor-loc{{#unless sp}} zero{{/unless}}"{{#if layerNames}} data-tooltip="{{layerNames}}"{{/if}}>
            <span class="ln"><span class="nm">{{label}}</span><span class="mult{{#if (gt mult 1)}} hot{{/if}}">{{multLabel}}</span></span>
            <span class="sp"><b>{{sp}}</b><span class="bar"><span style="width: {{pct}}%"></span></span></span>
          </div>
          {{/each}}
        </div>
        <div class="doll" aria-label="Доспех по частям тела">
          <img class="head" src="systems/vedmak/assets/glyphs/part-head-{{armorDoll.head}}.svg" alt="">
          <img class="torso" src="systems/vedmak/assets/glyphs/part-torso-{{armorDoll.torso}}.svg" alt="">
          <img class="rarm" src="systems/vedmak/assets/glyphs/part-arm-{{armorDoll.rightArm}}.svg" alt="">
          <img class="larm" src="systems/vedmak/assets/glyphs/part-arm-{{armorDoll.leftArm}}.svg" alt="">
          <img class="rleg" src="systems/vedmak/assets/glyphs/part-leg-{{armorDoll.rightLeg}}.svg" alt="">
          <img class="lleg" src="systems/vedmak/assets/glyphs/part-leg-{{armorDoll.leftLeg}}.svg" alt="">
        </div>
        <div class="doll-col">
          {{#each armorDoll.right}}
          <div class="armor-loc{{#unless sp}} zero{{/unless}}"{{#if layerNames}} data-tooltip="{{layerNames}}"{{/if}}>
            <span class="ln"><span class="nm">{{label}}</span><span class="mult{{#if (gt mult 1)}} hot{{/if}}">{{multLabel}}</span></span>
            <span class="sp"><b>{{sp}}</b><span class="bar"><span style="width: {{pct}}%"></span></span></span>
          </div>
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="armor-list">
        {{#each armorLocations}}
        <div class="armor-line"{{#if layerNames}} data-tooltip="{{layerNames}}"{{/if}}>
          <span class="part" data-tooltip="{{label}}">{{label}}</span>
          <span class="track"><span class="fill" style="width: {{pct}}%"></span></span>
          <b>{{sp}}</b>
          <span class="mult{{#if (gt mult 1)}} bad{{/if}}">{{multLabel}}</span>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if armorLayers}}
      <div class="armor-note">
        <span class="cap">СЛОИ</span>
        <span>{{armorLayers}}</span>
        {{#if armorResists}}<span class="res">Сопротивления: {{armorResists}}</span>{{/if}}
      </div>
      {{else}}
      <p class="hint">Брони нет — удары приходятся прямо по телу.</p>
      {{/if}}

      {{#each shields}}
      <div class="shield-line" data-item-id="{{id}}" data-tooltip="Блок щитом: прочность тратится за каждую блокированную атаку">
        <img src="{{img}}" alt="">
        <span class="name">{{name}}</span>
        <span class="cap">прочность</span>
        <b>{{reliability}}</b>
      </div>
      {{/each}}
    </section>
  </div>

  <section class="combat-block wounds">
    <div class="group-head">
      <span class="bronze-tag">КРИТИЧЕСКИЕ РАНЕНИЯ</span>
      <span class="rule"></span>
      <a class="add" data-action="critCreate" data-tooltip="Добавить вручную">добавить</a>
    </div>

    {{#each critWounds as |w|}}
    <div class="wound level-{{w.levelKey}} state-{{w.state}}" data-item-id="{{w.id}}">
      <img src="{{w.img}}" alt="" class="wound-icon">
      <div class="wound-body">
        <div class="wound-head">
          <a class="wound-name" data-action="itemEdit">{{w.name}}</a>
          <span class="tag level">{{w.levelLabel}}</span>
          <span class="dim">{{w.locationLabel}}{{#if w.teeth}} · зубов выбито {{w.teeth}}{{/if}}</span>
        </div>
        <p class="wound-text">{{w.text}}{{#if w.healingDays}} Штрафы пройдут через {{w.healingDays}} дн.{{/if}}</p>
        <p class="hint">{{w.hint}}</p>
      </div>
      <div class="wound-ctl">
        <select class="crit-state" data-tooltip="Состояние раны">
          {{#each w.states}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
        <a data-action="itemDelete" data-tooltip="Удалить"><i class="fa-solid fa-trash"></i></a>
      </div>
    </div>
    {{else}}
    <p class="hint">Ранений нет.</p>
    {{/each}}
  </section>

  {{#if isCharacter}}
  {{> "systems/vedmak/templates/actor/parts/effects.hbs"}}
  {{/if}}

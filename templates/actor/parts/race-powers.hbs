{{!-- Расовые навыки высшего вампира («Высший вампир. Вторая редакция»): Очки Крови, Шкала Зверя, роль и
      ветки навыков. Значения живут в предмете расы — поля .power-value и select[data-race-role] слушает лист
      (character-sheet.mjs). Карточки навыков повторяют ступени древа профессии (классы vp-*). --}}
{{#with vamp}}
<header class="vp-head vv-head" data-item-id="{{id}}">
  <span class="vp-frame"><img src="{{img}}" alt=""></span>
  <div class="vp-who">
    <a class="vp-name" data-action="itemEdit" data-tooltip="Открыть расу">{{name}}</a>
    <span class="vp-about">Расовые навыки открываются и растут за Очки Крови; заклинания — ОК, при нехватке — Выносливостью.</span>
  </div>
  <div class="vv-blood" data-tooltip="Очки Крови: максимум равен максимуму ПЗ">
    <span class="vd-cap">Очки Крови</span>
    <span class="vv-blood-row">
      <input type="number" name="system.blood.value" value="{{blood.value}}" min="0" {{#unless @root.editable}}disabled{{/unless}}
             aria-label="Очки Крови">
      <span class="vv-max">/ {{blood.max}}</span>
    </span>
    <span class="vv-bar"><span style="width: {{blood.pct}}%"></span></span>
  </div>
</header>

<section class="vv-beast{{#if beastFull}} full{{/if}}">
  <h3 class="vp-ghead">Шкала Зверя<span class="rule"></span></h3>
  <div class="vv-beast-row">
    <span class="vv-pips">
      {{#each beast}}<a class="vv-pip{{#if on}} on{{/if}}" data-action="setBeast" data-value="{{n}}" data-tooltip="{{n}} из 10" aria-label="Шкала Зверя: {{n}}"></a>{{/each}}
    </span>
    <span class="vd-cap">{{beastValue}} из 10 · пункт — за опьянение кровью и проваленное Сопротивление Жажде; откат — Сопротивление Зверю СЛ 35; полная шкала — срыв в Истинную форму</span>
  </div>
</section>

<section class="vv-roles">
  <h3 class="vp-ghead">Роль<span class="rule"></span></h3>
  <div class="vv-role-row">
    <label class="vv-role">
      <span class="vd-cap">одна на всю жизнь — сменить нельзя</span>
      <select data-race-role="role" {{#unless roleEditable}}disabled{{/unless}} aria-label="Роль высшего вампира">
        <option value="">— выбрать —</option>
        {{#each roles}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>
    {{#if roleDone}}<p class="vp-hint">Древо роли прокачано полностью; другой роли и её древа у высшего вампира не бывает.</p>{{/if}}
    {{#unless role}}<p class="vp-hint">Роль определяет ветку расовых навыков и вампирскую магию (бросок d10: Монарх 1–3, Заклинатель крови 4–7, Повелитель Теней 8–10).</p>{{/unless}}
  </div>
</section>

<div class="vp-branches vv-branches">
  {{#each groups as |group|}}
  <section class="vp-branch">
    <div class="vp-bar"><b>{{group.name}}</b></div>
    {{#if group.description}}<p class="vp-hint vv-role-desc">{{group.description}}</p>{{/if}}
    <div class="vp-chain">
      {{#each group.powers as |p|}}
      <div class="vp-ab{{#if p.learned}} learned{{/if}}{{#if p.locked}} locked{{/if}}">
        <div class="vp-ab-top">
          <span class="vp-ab-who">
            {{#if p.roll}}
            <a class="vp-ab-name" data-action="rollPower" data-key="{{p.key}}" data-tooltip="Проверка (Shift — без окна)">{{p.name}}</a>
            {{else}}
            <span class="vp-ab-name">{{p.name}}</span>
            {{/if}}
            <span class="vd-cap">{{p.kindLabel}}</span>
          </span>
          {{#if p.roll}}
          <a class="vp-base" data-action="rollPower" data-key="{{p.key}}" data-tooltip="{{p.baseHint}}. Бросок">{{p.base}}</a>
          {{else}}
          <span class="vp-base quiet" data-tooltip="Без проверки">—</span>
          {{/if}}
        </div>
        <div class="vp-ab-lvl">
          {{vedmakNotches p.value p.max}}
          <span class="vp-fill"></span>
          {{#if p.unlock}}
          <a class="improve{{#if p.unlock.short}} disabled{{/if}}" data-action="unlockPower" data-key="{{p.key}}"
             data-tooltip="{{p.unlock.label}} за {{p.unlock.cost}} ОК{{#if p.unlock.short}} — не хватает ОК{{/if}}"><i class="fa-solid fa-droplet"></i> <small>{{p.unlock.cost}}</small></a>
          {{/if}}
          <input class="power-value vp-lvl" type="number" value="{{p.value}}" min="0" max="{{p.max}}" data-key="{{p.key}}"
                 {{#unless @root.editable}}disabled{{/unless}} data-tooltip="Уровень" aria-label="Уровень: {{p.name}}">
        </div>
        {{#if p.form}}{{#with p.form as |f|}}
        <div class="vv-form{{#if f.active}} active{{/if}}{{#if f.frenzy}} frenzy{{/if}}">
          {{#if f.active}}
          <span class="vv-form-state">{{#if f.frenzy}}Звериный срыв{{else}}В Истинной форме{{/if}}{{#if f.rounds}} · {{f.rounds}} р.{{/if}}</span>
          <span class="vv-form-btns">
            {{#if f.frenzy}}
            <a class="vv-btn blood" data-action="tfRegain" data-tooltip="Сопротивление Зверю СЛ 20, нужно 3 успеха подряд">Вернуть разум {{f.streak}}/3</a>
            {{/if}}
            <a class="vv-btn{{#unless f.canExtend}} disabled{{/unless}}" data-action="tfExtend" data-tooltip="+1d6 раундов за 10 ОК">Продлить</a>
            {{#unless f.frenzy}}<a class="vv-btn" data-action="tfEnd" data-tooltip="Вернуть обычный облик">Выйти</a>{{else}}{{#if f.isGM}}<a class="vv-btn" data-action="tfEnd" data-tooltip="Ведущий: снять форму">Снять</a>{{/if}}{{/unless}}
          </span>
          {{else}}
          <span class="vv-form-state">{{#if f.cooldown}}Откат: ещё {{f.cooldown}}{{else if f.blocked}}Провал — до следующей сцены{{else if f.learned}}Готово · откат {{f.tier.cooldownText}}{{else}}Не изучено{{/if}}</span>
          <span class="vv-form-btns">
            <a class="vv-btn blood{{#if f.cooldown}} disabled{{/if}}{{#if f.blocked}} disabled{{/if}}{{#unless f.learned}} disabled{{/unless}}{{#unless f.enough}} disabled{{/unless}}"
               data-action="tfTransform" data-tooltip="Уровень + d10 против СЛ 16, 30 ОК (Shift — без окна)">Превратиться</a>
            {{#if f.cooldown}}{{#if f.isGM}}<a class="vv-btn" data-action="tfReset" data-tooltip="Ведущий: снять откат">Сбросить откат</a>{{/if}}{{/if}}
          </span>
          {{/if}}
        </div>
        {{/with}}{{/if}}
        {{#if p.stages}}
        <span class="vv-stages">{{#each p.stages}}<span class="vv-stage{{#if open}} open{{/if}}">{{label}} <small>{{cost}} ОК</small></span>{{/each}}</span>
        {{/if}}
        {{#if p.meta}}<span class="vd-cap vv-meta">{{p.meta}}</span>{{/if}}
        {{#if p.locked}}<span class="vp-lock"><i class="fa-solid fa-lock"></i> {{p.lockNote}}</span>{{/if}}
        <p class="vp-desc" tabindex="0" data-tooltip="Щёлкните, чтобы раскрыть">{{p.description}}</p>
      </div>
      {{/each}}
    </div>
  </section>
  {{/each}}
</div>
<p class="vp-hint">Ступень древа роли открывается за 10, 20 и 30 ОК после предыдущей; Превращение растёт на уровень за 10 ОК, стадии Лечения критических ранений — за 10/20/30/40 ОК. Прочие уровни книга не оценивает — ставьте их вручную. Сопротивление Жажде крови растёт за опыт, как обычный навык.</p>
{{/with}}

{{!-- Лист постройки (PLAN 4.198): производственная линия, лестница уровней, чертёж ступени у ведущего --}}
<div class="sv bl">
  <header class="sv-head">
    <span class="sv-sock big"><img class="sv-arms" src="{{actor.img}}" alt="" data-edit="img" data-tooltip="Герб постройки"></span>
    <div class="sv-title">
      {{#if editable}}<input class="sv-name" type="text" name="name" value="{{actor.name}}" aria-label="Название">
      {{else}}<h1 class="sv-name">{{actor.name}}</h1>{{/if}}
      <div class="sv-cal">
        {{#if gm}}<span class="sv-week"><select name="system.group" aria-label="Группа">{{selectOptions groups selected=sys.group}}</select></span>
        {{else}}<span class="sv-week">{{group}}</span>{{/if}}
        <i></i>
        {{#if gm}}
        <span class="sv-week" data-tooltip="Без поселения — образец в каталоге ведущего: его закладывают из каталога или перетащив на лист поселения">
          <select name="system.settlement" aria-label="Поселение">
            <option value="" {{#unless sys.settlement}}selected{{/unless}}>Образец каталога</option>
            {{#each settlements}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
          </select></span>
        {{#if town}}<a class="bl-goto" data-action="openActor" data-uuid="{{town.uuid}}" data-tooltip="Открыть поселение" aria-label="Открыть поселение"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>{{/if}}
        {{else if town}}<a class="ar-home" data-action="openActor" data-uuid="{{town.uuid}}">{{town.name}}</a>
        {{else}}<span>образец каталога</span>{{/if}}
      </div>
    </div>
  </header>

  <section class="sv-plaques">
    <div class="sv-plaque sv-approval tone-{{#if level.value}}high{{else}}low{{/if}}">
      <span class="sv-ring" style="--arc: {{level.arc}}deg"><b>{{level.value}}</b></span>
      <div class="sv-approval-text">
        <span class="cap">Уровень</span>
        <small>{{#if level.value}}из {{level.max}}{{else}}не построена{{/if}}</small>
        {{#if gm}}<label class="bl-mini bl-level-set" data-tooltip="Поставить уровень (ведущий)"><input type="number" name="system.level" value="{{level.value}}" min="0" max="{{level.max}}" step="1" aria-label="Уровень"></label>{{/if}}
      </div>
    </div>
    <div class="sv-plaque" data-tooltip="Семей ставят на работу на листе поселения">
      <span class="sv-medal">{{#if workers.max}}<b class="big">{{workers.value}}/{{workers.max}}</b>{{else}}<b class="big">—</b>{{/if}}</span>
      <span class="cap">Работают</span>
      {{#if workers.max}}<span class="bl-slots">{{#each workers.slots}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
      <small>{{workers.value}} из {{workers.max}} сем.</small>
      {{else}}<small>рабочих мест нет</small>{{/if}}
      {{#if gm}}<label class="bl-mini">семей <input type="number" name="system.workers" value="{{sys.workers}}" min="0" step="1"></label>{{/if}}
    </div>
    <div class="sv-plaque">
      <span class="sv-medal"><i class="fa-solid fa-hammer" aria-hidden="true"></i></span>
      <span class="cap">Стройка</span>
      {{#if build}}<b class="ar-label">{{build.n}}-я ступень</b>
      <span class="sv-bar"><i style="width: {{build.pct}}%"></i></span>
      <small>{{build.done}} из {{build.weeks}} нед.</small>
      {{else}}<b class="ar-label">{{#if sys.constructing}}идёт{{else}}нет{{/if}}</b><small>{{#if (lt level.value level.max)}}следующая — на листе поселения{{else}}построена целиком{{/if}}</small>{{/if}}
      {{#if gm}}<div class="bl-mini-row">
        <label class="bl-mini"><input type="checkbox" name="system.constructing" {{checked sys.constructing}}> идёт</label>
        <label class="bl-mini">нед. <input type="number" name="system.progress" value="{{sys.progress}}" min="0" step="1"></label>
      </div>{{/if}}
    </div>
    <div class="sv-plaque bl-manager" data-tooltip="Перетащите сюда персонажа: его навык «{{manager.skillLabel}}» даёт постройке бонус">
      {{#if manager.who}}
      <span class="sv-sock bl-mgr-sock"><img src="{{manager.who.img}}" alt=""></span>
      <span class="cap">Управляющий</span>
      <div class="bl-mgr">
        <div><a class="ar-home" data-action="openActor" data-uuid="{{manager.who.uuid}}">{{manager.who.name}}</a>
          <small>{{manager.skillLabel}} {{manager.value}} · {{manager.bonus}}</small></div>
        {{#if editable}}<a class="bl-x" data-action="clearManager" data-tooltip="Снять управляющего"><i class="fa-solid fa-xmark"></i></a>{{/if}}</div>
      {{else}}<span class="sv-medal empty"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
      <span class="cap">Управляющий</span>
      <small>никого — перетащите персонажа</small>{{/if}}
      {{#if gm}}<select name="system.managerSkill" class="bl-mgr-skill" aria-label="Навык управляющего"><option value="" {{#unless manager.override}}selected{{/unless}}>по постройке: {{manager.skillLabel}}</option>{{selectOptions manager.skills selected=manager.override}}</select>{{/if}}
    </div>
    <div class="sv-plaque">
      <span class="sv-medal"><i class="fa-solid fa-star" aria-hidden="true"></i></span>
      <span class="cap">Особое</span>
      <small class="bl-flags">{{#if sys.unique}}<span>одна на поселение</span>{{/if}}{{#if sys.trade}}<span>торговый пост</span>{{/if}}{{#unless sys.unique}}{{#unless sys.trade}}<span>—</span>{{/unless}}{{/unless}}</small>
      {{#if gm}}<div class="bl-mini-row">
        <label class="bl-mini"><input type="checkbox" name="system.unique" {{checked sys.unique}}> одна</label>
        <label class="bl-mini"><input type="checkbox" name="system.trade" {{checked sys.trade}}> торговля</label>
      </div>
      <label class="bl-mini" data-tooltip="По коду поселение узнаёт одинаковые постройки; пусто — название">код <input type="text" name="system.key" value="{{sys.key}}" placeholder="{{codePlaceholder}}"></label>{{/if}}
    </div>
  </section>

  <nav class="sv-tabs">
    {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="buildingTab" data-tab="{{id}}">{{label}}</a>{{/each}}
  </nav>

  <div class="sv-scroll">
  {{#if (eq tab "overview")}}

    {{!-- Производственная линия: сырьё → постройка → выработка --}}
    {{#if flow}}
    <section class="sv-block bl-flow {{#unless flow.built}}ghost{{/unless}}">
      <h3><span class="sv-tag">{{#if flow.built}}Что делает{{else}}После постройки{{/if}}</span><small>{{flow.n}}-я ступень</small></h3>
      <div class="bl-line">
        <div class="bl-side in">
          <span class="cap">Берёт</span>
          {{#each flow.consume}}<span class="bl-chip" data-tooltip="{{name}}{{#if notes}} · {{notes}}{{/if}}"><img src="{{img}}" alt=""><b>{{amount}}</b><small>{{name}}</small></span>
          {{else}}<span class="bl-none">ничего</span>{{/each}}
        </div>
        <span class="bl-arrow" aria-hidden="true"></span>
        <span class="bl-core"><img src="{{actor.img}}" alt=""></span>
        <span class="bl-arrow" aria-hidden="true"></span>
        <div class="bl-side out">
          <span class="cap">Даёт</span>
          {{#each flow.produce}}<span class="bl-chip" data-tooltip="{{name}}{{#if notes}} · {{notes}}{{/if}}"><img src="{{img}}" alt=""><b>{{amount}}</b><small>{{name}}{{#if notes}} · {{notes}}{{/if}}</small></span>
          {{else}}<span class="bl-none">ресурсов нет</span>{{/each}}
        </div>
      </div>
      {{#if flow.upkeep.length}}
      <div class="bl-upkeep"><span class="cap">Содержание</span>
        {{#each flow.upkeep}}<span class="bl-chip sm" data-tooltip="{{name}}{{#if notes}} · {{notes}}{{/if}}"><img src="{{img}}" alt=""><b>{{amount}}</b><small>{{name}}</small></span>{{/each}}
      </div>{{/if}}
      {{#if flow.tags.length}}
      <ul class="bl-tags">{{#each flow.tags}}<li><i class="fa-solid {{icon}}"></i><span>{{label}}</span><b>{{value}}</b></li>{{/each}}</ul>
      {{/if}}
    </section>
    {{/if}}

    {{!-- Заказы мастерской (PLAN 4.203) --}}
    {{#if orders}}
    <section class="sv-block bl-orders">
      <h3><span class="sv-tag">Заказы</span><small>делает: {{orders.types}} · перетащите предмет сюда</small></h3>
      {{#if orders.list.length}}
      <ul class="bl-order-list">
        {{#each orders.list}}
        <li data-order="{{id}}" class="{{#if first}}now{{/if}}">
          <span class="sv-sock sm"><img src="{{img}}" alt=""></span>
          <div><b>{{name}}{{#if (gt qty 1)}} ×{{qty}}{{/if}}</b><small>для {{forName}} · {{cost}}</small>
            <span class="sv-bar"><i style="width: {{pct}}%"></i></span><small>{{progress}} из {{weeks}} нед.{{#unless first}} · в очереди{{/unless}}</small></div>
          {{#if @root.editable}}<a class="bl-x" data-action="cancelOrder" data-tooltip="Снять заказ (потраченное не вернётся)"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{else}}<p class="sv-hint sv-empty">Заказов нет. Перетащите на лист предмет из компендиума, мира или с листа персонажа — мастерская сделает его из ресурсов склада.</p>{{/if}}
    </section>
    {{/if}}

    {{!-- Лестница уровней --}}
    <section class="sv-block bl-ladder">
      <h3><span class="sv-tag">Уровни</span><small>цена — со склада поселения, строят семьи без дела</small></h3>
      <ol class="bl-steps">
        {{#each track}}
        <li class="bl-step {{state}} {{#if current}}current{{/if}} {{#if editing}}editing{{/if}}" data-level="{{index}}">
          <span class="bl-n">{{n}}</span>
          <div class="bl-step-body">
            <div class="bl-cost">{{#each cost}}<span class="bl-chip sm {{#if short}}short{{/if}}" data-tooltip="{{name}}{{#if short}} — на складе не хватает{{/if}}"><img src="{{img}}" alt=""><b>{{qty}}</b></span>{{else}}<span class="bl-none">даром</span>{{/each}}</div>
            <div class="bl-facts">
              <span data-tooltip="Недель стройки"><i class="fa-solid fa-hammer"></i> {{#if weeks}}{{weeks}} нед.{{else}}сразу{{/if}}</span>
              {{#if families}}<span data-tooltip="Рабочих мест"><i class="fa-solid fa-people-group"></i> {{families}}</span>{{/if}}
              {{#if housing}}<span data-tooltip="Живёт семей"><i class="fa-solid fa-house"></i> {{housing}}</span>{{/if}}
            </div>
            {{#if produce.length}}<div class="bl-gives">{{#each produce}}<span class="bl-chip xs" data-tooltip="{{name}}"><img src="{{img}}" alt=""><b>{{amount}}</b></span>{{/each}}</div>{{/if}}
            {{#if tags}}<small class="bl-step-tags">{{tags}}</small>{{/if}}
          </div>
          {{#if @root.gm}}<a class="bl-edit" data-action="editLevel" data-tooltip="{{#if editing}}Свернуть чертёж{{else}}Править ступень{{/if}}"><i class="fa-solid {{#if editing}}fa-chevron-up{{else}}fa-pen{{/if}}"></i></a>{{/if}}
        </li>
        {{/each}}
        {{#if gm}}<li class="bl-step add"><a data-action="blLevelAdd"><i class="fa-solid fa-plus"></i><span>Ступень</span></a></li>{{/if}}
      </ol>
    </section>

    {{!-- Чертёж открытой ступени (ведущий) --}}
    {{#if edit}}
    <section class="sv-block bl-blueprint" data-level="{{edit.index}}">
      <datalist id="bl-res-{{actor.id}}">{{#each resourceNames}}<option value="{{this}}"></option>{{/each}}</datalist>
      <h3><span class="sv-tag">Чертёж {{edit.n}}-й ступени</span>
        {{#if canDelete}}<a class="bl-del" data-action="blLevelDelete" data-level="{{edit.index}}" data-tooltip="Убрать ступень"><i class="fa-solid fa-trash"></i></a>{{/if}}</h3>
      <div class="bl-fields">
        {{#each edit.fields}}<label data-tooltip="{{hint}}"><span>{{label}}</span><input type="number" name="{{name}}" value="{{value}}" min="0" step="{{step}}"></label>{{/each}}
      </div>
      <div class="bl-group">
        <span class="cap">Цена</span>
        <div class="bl-costs">
          {{#each edit.cost}}
          <span class="bl-cost-row">
            <input type="text" name="{{resource.name}}" value="{{resource.value}}" list="bl-res-{{@root.actor.id}}" placeholder="Ресурс или Богатство">
            <input type="number" name="{{qty.name}}" value="{{qty.value}}" min="0" step="any">
            <a data-action="blDelete" data-level="{{@root.edit.index}}" data-list="cost" data-index="{{j}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a>
          </span>
          {{/each}}
          <a class="bl-plus" data-action="blAdd" data-level="{{edit.index}}" data-list="cost"><i class="fa-solid fa-plus"></i> ресурс</a>
        </div>
      </div>
      {{#each edit.lists as |L|}}
      <div class="bl-group">
        <span class="cap" data-tooltip="{{L.hint}}">{{L.label}}</span>
        {{#if L.rows.length}}
        <table class="bl-rows">
          <thead><tr><th>Ресурс</th><th>Бросок</th><th>Кому</th><th>Как часто</th><th data-tooltip="Нужно семей на работе">Семей</th>
            <th data-tooltip="Зимой нет">Не зимой</th>{{#if L.same}}<th data-tooltip="Столько же, сколько выпало строкой выше">Столько же</th>{{/if}}<th></th></tr></thead>
          <tbody>
            {{#each L.rows}}
            <tr>
              <td><input type="text" name="{{resource.name}}" value="{{resource.value}}" list="bl-res-{{@root.actor.id}}"></td>
              <td><input type="text" name="{{formula.name}}" value="{{formula.value}}" class="bl-formula"></td>
              <td><select name="{{per.name}}">{{selectOptions @root.perOptions selected=per.value}}</select></td>
              <td><select name="{{period.name}}">{{selectOptions @root.periodOptions selected=period.value}}</select></td>
              <td><input type="number" name="{{minFamilies.name}}" value="{{minFamilies.value}}" min="0" step="1"></td>
              <td class="c"><input type="checkbox" name="{{noWinter.name}}" {{checked noWinter.value}}></td>
              {{#if L.same}}<td class="c"><input type="checkbox" name="{{same.name}}" {{checked same.value}}></td>{{/if}}
              <td><a data-action="blDelete" data-level="{{@root.edit.index}}" data-list="{{list}}" data-index="{{j}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a></td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
        <a class="bl-plus" data-action="blAdd" data-level="{{@root.edit.index}}" data-list="{{L.list}}"><i class="fa-solid fa-plus"></i> строка</a>
      </div>
      {{/each}}
    </section>
    {{/if}}
  {{/if}}

  {{#if (eq tab "tree")}}
    {{!-- Обустройство (кусок Б): ветки колонками, ступени цепочкой --}}
    <div class="bl-tree-bar">
      <span class="sv-hint">Ступень — цена со склада поселения сразу, недели строят семьи без дела (как уровень). Ветки открыты все: со временем можно взять всё.</span>
      {{#if gm}}<a class="sv-btn {{#if treeEdit}}on{{/if}}" data-action="treeEdit">{{#if treeEdit}}Готово{{else}}Править дерево{{/if}}</a>{{/if}}
    </div>
    {{#if tree.length}}
    <div class="bl-branches">
      {{#each tree as |br|}}
      <section class="bl-branch">
        <header>
          <span class="bl-branch-icon"><i class="fa-solid {{br.icon}}"></i></span>
          {{#if @root.treeEdit}}
          <input type="text" name="{{br.path}}.name" value="{{br.name}}" aria-label="Название ветки">
          <input type="text" name="{{br.path}}.icon" value="{{br.icon}}" class="bl-icon-in" data-tooltip="Значок Font Awesome: fa-hammer, fa-wheat-awn…" aria-label="Значок">
          <a class="bl-x" data-action="treeDel" data-path="branches" data-index="{{br.index}}" data-tooltip="Убрать ветку"><i class="fa-solid fa-trash"></i></a>
          {{else}}<b>{{br.name}}</b><small>{{br.done}} из {{br.total}}</small>{{/if}}
        </header>
        <ol class="bl-nodes">
          {{#each br.nodes as |nd|}}
          <li class="bl-node {{nd.state}}" data-node="{{nd.id}}">
            {{#if @root.treeEdit}}
            <div class="bl-node-edit">
              <input type="text" name="{{nd.path}}.name" value="{{nd.name}}" class="bl-node-name-in" aria-label="Название ступени">
              <div class="bl-node-nums">
                <label data-tooltip="Нужный уровень постройки">ур. <input type="number" name="{{nd.path}}.level" value="{{nd.level}}" min="0" step="1"></label>
                <label data-tooltip="Недель стройки; 0 — сразу">нед. <input type="number" name="{{nd.path}}.weeks" value="{{nd.weeks}}" min="0" step="1"></label>
                <a class="bl-x" data-action="treeDel" data-path="system.branches.{{br.index}}.nodes" data-index="{{nd.index}}" data-tooltip="Убрать ступень"><i class="fa-solid fa-trash"></i></a>
              </div>
              <textarea name="{{nd.path}}.description" rows="2" placeholder="Что это">{{nd.description}}</textarea>
              <div class="bl-node-list">
                <span class="cap">Цена</span>
                {{#each nd.cost}}<span class="bl-cost-row">
                  <input type="text" name="{{path}}.resource" value="{{resource}}" list="bl-res-{{@root.actor.id}}" placeholder="Ресурс">
                  <input type="number" name="{{path}}.qty" value="{{qty}}" min="0" step="any">
                  <a data-action="treeDel" data-path="{{nd.path}}.cost" data-index="{{index}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a></span>{{/each}}
                <a class="bl-plus" data-action="treeAdd" data-kind="cost" data-path="{{nd.path}}.cost"><i class="fa-solid fa-plus"></i> ресурс</a>
              </div>
              <div class="bl-node-list">
                <span class="cap">Эффекты</span>
                {{#each nd.effects}}
                <div class="bl-eff-row">
                  <select name="{{path}}.type">{{selectOptions @root.effectTypes selected=type}}</select>
                  {{#if res}}<input type="text" name="{{path}}.resource" value="{{resource}}" list="bl-res-{{@root.actor.id}}" placeholder="{{#if row}}Ресурс{{else}}все ресурсы{{/if}}">{{/if}}
                  {{#if row}}
                  <input type="text" name="{{path}}.formula" value="{{formula}}" class="bl-formula" aria-label="Бросок">
                  <select name="{{path}}.per">{{selectOptions @root.perOptions selected=per}}</select>
                  <select name="{{path}}.period">{{selectOptions @root.periodOptions selected=period}}</select>
                  {{else if dice}}<label class="bl-eff-val" data-tooltip="Бросок — столько раз, какой уровень постройки"><input type="text" name="{{path}}.formula" value="{{diceFormula}}" class="bl-formula"> за ур.</label>
                  {{else}}<label class="bl-eff-val"><input type="number" name="{{path}}.value" value="{{value}}" step="any"></label>{{/if}}
                  <a data-action="treeDel" data-path="{{nd.path}}.effects" data-index="{{index}}" aria-label="Убрать"><i class="fa-solid fa-xmark"></i></a>
                </div>
                {{/each}}
                <a class="bl-plus" data-action="treeAdd" data-kind="effect" data-path="{{nd.path}}.effects"><i class="fa-solid fa-plus"></i> эффект</a>
              </div>
            </div>
            {{else}}
            <div class="bl-node-head">
              <b>{{nd.name}}</b>
              {{#if @root.gm}}<a class="bl-grant" data-action="grant" data-tooltip="{{#if (eq nd.state "bought")}}Забрать ступень{{else}}Выдать даром{{/if}}"><i class="fa-solid {{#if (eq nd.state "bought")}}fa-rotate-left{{else}}fa-gift{{/if}}"></i></a>{{/if}}
            </div>
            {{#if nd.description}}<p class="bl-node-desc">{{nd.description}}</p>{{/if}}
            <ul class="bl-effects">{{#each nd.effects}}<li>{{label}}</li>{{else}}<li class="none">без эффекта</li>{{/each}}</ul>
            <div class="bl-node-foot">
              {{#if (eq nd.state "bought")}}<span class="bl-done"><i class="fa-solid fa-check"></i> взята</span>
              {{else if (eq nd.state "working")}}
                <span class="bl-work"><span class="sv-bar"><i style="width: {{nd.progress.pct}}%"></i></span><small>{{nd.progress.done}} из {{nd.progress.weeks}} нед.</small></span>
                {{#if @root.editable}}<a class="bl-cancel" data-action="cancelResearch" data-tooltip="Бросить (потраченное не вернётся)"><i class="fa-solid fa-xmark"></i></a>{{/if}}
              {{else}}
                <span class="bl-cost">{{#each nd.cost}}<span class="bl-chip xs {{#if short}}short{{/if}}" data-tooltip="{{resource}}"><img src="{{img}}" alt=""><b>{{qty}}</b></span>{{else}}<span class="bl-none">даром</span>{{/each}}</span>
                <small class="bl-weeks"><i class="fa-solid fa-hammer"></i> {{#if nd.weeks}}{{nd.weeks}} нед.{{else}}сразу{{/if}}</small>
                {{#if (eq nd.state "open")}}{{#if @root.editable}}<a class="sv-btn bl-take" data-action="research">Взять</a>{{/if}}
                {{else}}<small class="bl-why"><i class="fa-solid fa-lock"></i> {{nd.why}}</small>{{/if}}
              {{/if}}
            </div>
            {{/if}}
          </li>
          {{/each}}
          {{#if @root.treeEdit}}<li class="bl-node add"><a data-action="treeAdd" data-kind="node" data-path="system.branches.{{br.index}}.nodes"><i class="fa-solid fa-plus"></i> ступень</a></li>{{/if}}
        </ol>
      </section>
      {{/each}}
      {{#if treeEdit}}<section class="bl-branch add"><a data-action="treeAdd" data-kind="branch"><i class="fa-solid fa-plus"></i><span>Ветка</span></a></section>{{/if}}
    </div>
    {{else}}
    <p class="sv-hint">У постройки нет веток обустройства.{{#if gm}} Нажмите «Править дерево», чтобы добавить.{{/if}}</p>
    {{#if treeEdit}}<div class="bl-branches"><section class="bl-branch add"><a data-action="treeAdd" data-kind="branch"><i class="fa-solid fa-plus"></i><span>Ветка</span></a></section></div>{{/if}}
    {{/if}}
    {{#if treeEdit}}<datalist id="bl-res-{{actor.id}}">{{#each resourceNames}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
  {{/if}}

  {{#if (eq tab "notes")}}
    <section class="sv-block sv-notes">
      {{#if editable}}
      {{formInput systemFields.description value=sys.description enriched=enrichedDescription toggled=true}}
      {{else}}{{{enrichedDescription}}}{{/if}}
    </section>
  {{/if}}
  </div>
</div>

<section class="tab skills-tab{{#if advanceMode}} advancing{{/if}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{#if isCharacter}}

  {{!-- Переключатель подвкладок живёт внутри вкладки: без второй полосы поперёк листа --}}
  <div class="skills-head">
    <nav class="tabs pane-switch" aria-label="Навыки и профессия">
      <a class="{{skillTabs.list.cssClass}}" data-action="tab" data-group="skills" data-tab="list">
        <span>Навыки</span><span class="count">{{trainedCount}}</span>
      </a>
      <a class="{{skillTabs.profession.cssClass}}" data-action="tab" data-group="skills" data-tab="profession">
        <span>Профессия</span>{{#if prof}}<span class="count">{{prof.learned}}/{{prof.total}}</span>{{/if}}
      </a>
    </nav>
    <span class="grow"></span>
    <a class="toggle trained-toggle{{#if trainedOnly}} active{{/if}}" data-action="toggleTrainedOnly">
      {{#if trainedOnly}}Показать все{{else}}Только изученные{{/if}}
    </a>
  </div>

  {{#if advanceMode}}
  <div class="advance-bar">
    <b>Развитие</b>
    <span class="hint-inline">новый уровень навыка — 1 О.У, дальше — текущий уровень</span>
    <span class="grow"></span>
    <span class="ip">осталось <b>{{system.improvementPoints.value}}</b> О.У.</span>
    <a class="rail-btn" data-action="toggleAdvance">Выйти</a>
  </div>
  {{/if}}

  <div class="tab pane {{skillTabs.list.cssClass}}" data-group="skills" data-tab="list">
    {{> "systems/vedmak/templates/actor/parts/skill-list.hbs"}}
  </div>
  <div class="tab pane {{skillTabs.profession.cssClass}}" data-group="skills" data-tab="profession">
    {{> "systems/vedmak/templates/actor/parts/profession.hbs"}}
  </div>

  {{else}}

  <div class="skills-head">
    <span class="grow"></span>
    <a class="toggle trained-toggle{{#if trainedOnly}} active{{/if}}" data-action="toggleTrainedOnly">
      {{#if trainedOnly}}Показать все{{else}}Только изученные{{/if}}
    </a>
  </div>
  {{> "systems/vedmak/templates/actor/parts/skill-list.hbs"}}

  {{/if}}
</section>

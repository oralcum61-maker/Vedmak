{{!-- Лист поселения (PLAN 4.183, 4.185): правила журнала мира manorlords, уровни построек, налоги, склад, торговля --}}
<div class="sv">
  <header class="sv-head">
    <span class="sv-sock big"><img class="sv-arms" src="{{actor.img}}" alt="" data-edit="img" data-tooltip="Герб поселения"></span>
    <div class="sv-title">
      {{#if editable}}<input class="sv-name" type="text" name="name" value="{{actor.name}}" aria-label="Название">
      {{else}}<h1 class="sv-name">{{actor.name}}</h1>{{/if}}
      <div class="sv-cal">
        {{#if gm}}
        <span class="sv-week"><select name="system.month" aria-label="Месяц">{{#each cal.months}}<option value="{{n}}" {{#if on}}selected{{/if}}>{{label}}</option>{{/each}}</select>
          <input type="number" name="system.week" value="{{cal.week}}" min="1" max="4" step="1" aria-label="Неделя месяца">-я неделя</span>
        {{else}}<span class="sv-week">{{cal.monthLabel}}, {{cal.week}}-я неделя</span>{{/if}}
        <i></i><span>{{cal.seasonLabel}}</span><i></i>
        <span>год {{#if gm}}<input type="number" name="system.year" value="{{cal.year}}" min="1" step="1" class="sv-year" aria-label="Год">{{else}}{{cal.year}}{{/if}}</span>
      </div>
    </div>
    {{#if gm}}<button type="button" class="sv-next" data-action="week" data-tooltip="Бросить выработку построек, посчитать нужды, стройку и — в конце месяца — приход семей и бунт; итог — в чат">Прошла неделя</button>{{/if}}
  </header>

  <section class="sv-plaques">
    <div class="sv-plaque" data-tooltip="Работают: {{families.assigned}} · без дела: {{families.idle}}{{#if families.builders}} (строят: {{families.builders}}){{/if}}">
      <span class="cap">Семьи</span>
      {{#if gm}}<input type="number" name="system.families" value="{{sys.families}}" min="0" step="1" class="big">{{else}}<b class="big">{{families.value}}</b>{{/if}}
      <small>домов {{families.houses}}{{#if families.homeless}} · <span class="warn">бездомных {{families.homeless}}</span>{{/if}} · без дела {{families.idle}}</small>
    </div>
    <div class="sv-plaque sv-approval tone-{{approval.tone}}">
      <span class="sv-ring" style="--arc: {{approval.arc}}deg"><b>{{approval.value}}</b></span>
      <div class="sv-approval-text">
        <span class="cap">Одобрение</span>
        <small>{{approval.note}}</small>
        {{#if gm}}<div class="sv-mini-acts"><a data-action="approval" data-delta="-1" class="{{#unless approval.canDown}}off{{/unless}}">−1</a><a data-action="approval" data-delta="1" class="{{#unless approval.canUp}}off{{/unless}}">+1</a></div>{{/if}}
      </div>
    </div>
    <div class="sv-plaque" data-tooltip="{{wealth.rate}}">
      <span class="cap">Казна · Богатство</span>
      {{#if gm}}<input type="number" name="system.wealth" value="{{wealth.raw}}" min="0" step="any" class="big">{{else}}<b class="big">{{wealth.value}}</b>{{/if}}
      <small>{{wealth.coins}}{{#if wealth.gain}} · {{wealth.gain}}{{/if}}</small>
      {{#if editable}}<div class="sv-mini-acts">
        <a data-action="wealth" data-mode="deposit" data-tooltip="Из кошелька {{#if wealth.hero}}{{wealth.hero}}{{else}}своего персонажа{{/if}}">Внести</a>
        <a data-action="wealth" data-mode="withdraw" data-tooltip="В кошелёк {{#if wealth.hero}}{{wealth.hero}}{{else}}своего персонажа{{/if}}">Взять</a>
      </div>{{/if}}
    </div>
    <div class="sv-plaque">
      <span class="cap">Налог</span>
      <select name="system.taxes" {{#unless editable}}disabled{{/unless}}>
        {{#each taxes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <small>{{taxNote}}</small>
    </div>
    <div class="sv-plaque sv-duo">
      <label><span class="cap">Ополчение</span>{{#if gm}}<input type="number" name="system.militia" value="{{sys.militia}}" min="0" step="1">{{else}}<b>{{sys.militia}}</b>{{/if}}</label>
      <label data-tooltip="Уровень Контроля: каждый снимает 5% шанса бунта. Свой — от событий и стражи; постройки добавляют сверху"><span class="cap">Контроль</span>{{#if gm}}<input type="number" name="system.control" value="{{sys.control}}" min="0" step="1">{{else}}<b>{{sys.control}}</b>{{/if}}
        {{#if (gt families.control sys.control)}}<small>всего {{families.control}}</small>{{/if}}</label>
    </div>
  </section>

  <nav class="sv-tabs">
    {{#each tabs}}<a class="{{#if active}}active{{/if}}" data-action="tab" data-tab="{{id}}">{{label}}</a>{{/each}}
  </nav>

  <div class="sv-scroll">
  {{#if (eq tab "economy")}}
    <section class="sv-block">
      <h3><span class="sv-tag">Склад</span><small>до {{storage}} каждого · ≈ — в среднем за неделю</small></h3>
      <ul class="sv-res">
        {{#each resources}}
        <li class="{{#if full}}full{{/if}}">
          <span class="sv-sock sm"><img src="{{img}}" alt=""></span>
          <div class="sv-res-main">
            <span class="nm">{{name}}</span>
            {{#if ../gm}}<input type="number" name="system.stock.{{name}}" value="{{raw}}" min="0" step="any">{{else}}<b>{{value}}</b>{{/if}}
            <span class="cap-of">/ {{cap}}</span>
            {{#if net}}<em class="{{#if up}}up{{/if}}{{#if down}}down{{/if}}">{{net}}</em>{{/if}}
            <span class="sv-bar"><i style="width: {{pct}}%"></i></span>
          </div>
          {{#if ../gm}}{{#unless need}}<a class="sv-res-x" data-action="removeResource" data-name="{{name}}" data-tooltip="Убрать ресурс со склада">×</a>{{/unless}}{{/if}}
          {{#if ../trade}}{{#if ../editable}}
          <div class="sv-trade">
            <a data-action="trade" data-name="{{name}}" data-mode="sell" data-tooltip="Продать: {{sell}} за единицу">Продать</a>
            <a data-action="trade" data-name="{{name}}" data-mode="buy" data-tooltip="Купить: {{buy}} за единицу">Купить</a>
          </div>
          {{/if}}{{/if}}
        </li>
        {{/each}}
      </ul>
      <div class="sv-res-bar">
        {{#if trade}}{{#if editable}}<label class="sv-qty">Торговать по <input class="sv-trade-qty" type="number" min="1" step="1" value="{{tradeQty}}"> ед.</label>{{/if}}
        {{else}}<span class="sv-hint">Торговли нет: купцы заезжают только к торговому посту.</span>{{/if}}
        {{#if gm}}<span class="sv-add-res"><input class="sv-new-res" type="text" placeholder="Новый ресурс" aria-label="Новый ресурс">
          <input class="sv-new-qty" type="number" min="0" step="1" value="0" aria-label="Сколько"><a class="sv-btn" data-action="addResource">Добавить</a></span>{{/if}}
      </div>
    </section>

    <div class="sv-cols">
      <section class="sv-block">
        <h3><span class="sv-tag">Нужды семей</span><small>в неделю{{#if cal.winter}}, зима — топлива вдвое{{/if}}</small></h3>
        <ul class="sv-needs">
          {{#each needs}}
          <li class="{{#if ok}}ok{{else}}short{{/if}}"><span>{{label}}</span><b>{{got}} / {{need}}</b><span class="sv-bar"><i style="width: {{pct}}%"></i></span></li>
          {{/each}}
        </ul>
      </section>
      <section class="sv-block">
        <h3><span class="sv-tag">Конец месяца</span><small>{{month.when}}</small></h3>
        <ul class="sv-parts sv-month">
          <li><span>{{month.arrival}}</span></li>
          {{#if month.revolt}}<li class="warn"><span>{{month.revolt}}</span></li>{{/if}}
          {{#if month.taxes}}<li><span>{{month.taxes}}</span></li>{{/if}}
          {{#if month.content}}<li class="up"><span>Народ доволен: возможны дополнительные ресурсы — решает ведущий.</span></li>{{/if}}
        </ul>
      </section>
    </div>
  {{/if}}

  {{#if (eq tab "buildings")}}
    {{#if editable}}
    <div class="sv-build-bar">
      <a class="sv-btn {{#if showCatalog}}on{{/if}}" data-action="catalog">{{#if showCatalog}}Скрыть каталог{{else}}Построить…{{/if}}</a>
      <span class="sv-hint">Строят семьи без дела: одна семья — неделя стройки. Без дела: {{families.idle}}. Свою постройку сделайте в предметах («Постройка») и перетащите сюда.</span>
    </div>
    {{#if showCatalog}}
    <ul class="sv-catalog">
      {{#each catalog}}
      <li class="{{#unless ok}}off{{/unless}}">
        <span class="sv-sock"><img src="{{img}}" alt=""></span>
        <div><b>{{label}}{{#if mine}} <em class="sv-mine">своя</em>{{/if}}</b><small>{{hint}}</small><span class="sv-cost">{{cost}} · {{weeks}} нед.{{#if (gt levels 1)}} · уровней: {{levels}}{{/if}}</span></div>
        <button type="button" data-action="build" data-src="{{src}}" {{#unless ok}}disabled data-tooltip="{{why}}"{{/unless}}>{{#if taken}}Есть{{else}}Заложить{{/if}}</button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{/if}}

    {{#each groups}}
    <section class="sv-block">
      <h3><span class="sv-tag">{{label}}</span></h3>
      <ul class="sv-cards">
        {{#each cards}}
        <li class="sv-card {{#if constructing}}building{{/if}}" data-id="{{id}}">
          <span class="sv-sock" data-tooltip="{{hint}}"><img src="{{img}}" alt=""></span>
          <div class="sv-card-main">
            <div class="sv-card-head">
              <b>{{name}}</b>
              <span class="sv-pips">{{#each pips}}<i class="{{#if on}}on{{/if}}{{#if next}} next{{/if}}"></i>{{/each}}</span>
            </div>
            {{#if progress}}
            <div class="sv-progress {{#if stalled}}stalled{{/if}}"><span class="sv-bar"><i style="width: {{progress.pct}}%"></i></span>
              <small>{{#if firstBuild}}Строится{{else}}Улучшается{{/if}}: {{progress.done}} из {{progress.weeks}} нед.{{#if stalled}} — нет свободных семей{{/if}}</small></div>
            {{/if}}
            {{#if gives}}<small class="sv-gives">{{gives}}{{#if idle}} · <span class="warn">никто не работает</span>{{/if}}</small>{{/if}}
            <div class="sv-card-acts">
              {{#if max}}
              <span class="sv-workers" data-tooltip="Семьи на работе">
                {{#if ../../editable}}<a data-action="workers" data-delta="-1" class="{{#unless canLess}}off{{/unless}}">−</a>{{/if}}
                <b>{{workers}}</b>/{{max}}
                {{#if ../../editable}}<a data-action="workers" data-delta="1" class="{{#unless canMore}}off{{/unless}}">+</a>{{/if}}
              </span>
              {{/if}}
              {{#if ../../editable}}
              {{#if upgrade}}<button type="button" data-action="upgrade" {{#unless upgrade.ok}}disabled{{/unless}} data-tooltip="{{upgrade.cost}} · {{upgrade.weeks}} нед.">Улучшить</button>{{/if}}
              <a class="sv-edit" data-action="editBuilding" data-tooltip="Править постройку: название, выработка, содержание, уровни"><i class="fa-solid fa-pen"></i></a>
              <a class="sv-demolish" data-action="demolish" data-tooltip="{{#if firstBuild}}Бросить стройку{{else}}Снести{{/if}}">×</a>
              {{/if}}
            </div>
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}
    <p class="sv-hint">Пока ничего не построено. Начните с жилых домов и лагеря лесорубов.</p>
    {{/each}}
  {{/if}}

  {{#if (eq tab "chronicle")}}
    <ol class="sv-chronicle">
      {{#each chronicle}}
      <li>
        <header><b>{{when}}</b><span>{{season}}, год {{year}}</span></header>
        {{#if lines}}<p>{{lines}}</p>{{/if}}
        {{#if wealth}}<p>Казна: {{wealth}}</p>{{/if}}
        {{#if shortages}}<p class="warn">Не хватило: {{shortages}}</p>{{/if}}
        {{#each events}}<p>{{this}}</p>{{/each}}
        {{#if built}}<p>Достроено: {{built}}</p>{{/if}}
      </li>
      {{else}}
      <li class="sv-hint">Недели ещё не проходили.</li>
      {{/each}}
    </ol>
  {{/if}}

  {{#if (eq tab "notes")}}
    <section class="sv-block sv-notes">
      {{#if editable}}
      {{formInput systemFields.description value=sys.description enriched=enrichedDescription toggled=true}}
      {{else}}{{{enrichedDescription}}}{{/if}}
    </section>
  {{/if}}
  </div>
</div>

<section class="tab stats-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Холст design/11 (PLAN 4.60): параметры — строки с медальоном итога, производные — медальоны, поправки — поля. --}}
  <div class="vm-columns">
    <section class="vm-plate vm-stats">
      <div class="vm-bar"><b>Параметры</b><span class="vm-fill"></span><span class="vd-cap">база · мод. · итог</span></div>
      <div class="vm-stat-list">
        {{#each stats}}
        <div class="vm-stat{{#if (ne total effective)}} reduced{{/if}}">
          <a class="vm-stat-name" data-action="rollStat" data-stat="{{key}}" data-tooltip="Проверка параметра (Shift — без окна)">{{label}}</a>
          <input type="number" name="system.stats.{{key}}.base" value="{{base}}" min="0" aria-label="База: {{label}}">
          <span class="vm-mod">{{vedmakSigned mod}}</span>
          <a class="vm-total" data-action="rollStat" data-stat="{{key}}" data-tooltip="Итог. Бросок">{{> "systems/vedmak/templates/actor/parts/medal.hbs" value=effective cls="vm-m34"}}</a>
        </div>
        {{/each}}
      </div>
    </section>

    <div class="vm-col">
      <section class="vm-plate">
        <div class="vm-bar"><b>Производные</b></div>
        <div class="vm-derived">
          {{#each derived}}
          <div class="vm-der" data-tooltip="{{label}}">
            {{> "systems/vedmak/templates/actor/parts/medal.hbs" value=value cls="vm-m50"}}
            <span class="vd-cap">{{abbr}}{{#if unit}}, {{unit}}{{/if}}</span>
          </div>
          {{/each}}
        </div>
      </section>
      <section class="vm-plate vm-bonus">
        <h3 class="vm-ghead">Поправки<span class="rule"></span></h3>
        <div class="vm-fields">
          <label><span class="vd-cap">Энергия (база)</span><input type="number" name="system.vigor" value="{{system.vigor}}" min="0"></label>
          <label><span class="vd-cap">ПЗ</span><input type="number" name="system.bonus.hp" value="{{source.system.bonus.hp}}"></label>
          <label><span class="vd-cap">Вын</span><input type="number" name="system.bonus.sta" value="{{source.system.bonus.sta}}"></label>
          <label><span class="vd-cap">Уст</span><input type="number" name="system.bonus.stun" value="{{source.system.bonus.stun}}"></label>
          <label><span class="vd-cap">Бег</span><input type="number" name="system.bonus.run" value="{{source.system.bonus.run}}"></label>
          <label><span class="vd-cap">Отдых</span><input type="number" name="system.bonus.rec" value="{{source.system.bonus.rec}}"></label>
        </div>
        <p class="vm-hint">В бестиарии ПЗ и Вын даны готовыми числами — подгоните бонусом разницу с формулой.</p>
      </section>
    </div>
  </div>

  <div class="vd-panel defenses-panel">
    <h3>Защиты чудовища</h3>
    <div class="vd-grid g4">
      <label>Таблица частей тела <select name="system.bodyType">{{selectOptions bodyTypes selected=system.bodyType}}</select></label>
      <label>Размер <select name="system.size">{{selectOptions sizes selected=system.size}}</select></label>
      <label>Уязвим к металлу <select name="system.materialWeakness">{{selectOptions weaknesses selected=system.materialWeakness}}</select></label>
      <label>Сейчас <span class="value-box">{{weaknessNow}}</span></label>
      <label class="check"><input type="checkbox" name="system.noAnatomy" {{checked system.noAnatomy}}> Нет органов (дух)</label>
      <label class="check"><input type="checkbox" name="system.noLegs" {{checked system.noLegs}}> Нет ног</label>
    </div>
    <div class="resist-block">
      <span class="field-label">Сопротивление (урон ×½, +2 к проверкам против эффекта)</span>
      <multi-checkbox name="system.resistances">{{selectOptions resistKeys selected=system.resistances}}</multi-checkbox>
    </div>
    <div class="resist-block">
      <span class="field-label">Восприимчивость (урон ×2)</span>
      <multi-checkbox name="system.susceptibilities">{{selectOptions resistKeys selected=system.susceptibilities}}</multi-checkbox>
    </div>
    <div class="resist-block">
      <span class="field-label">Невосприимчивость</span>
      <multi-checkbox name="system.immunities">{{selectOptions resistKeys selected=system.immunities}}</multi-checkbox>
    </div>
    <p class="hint">Все чудовища, кроме зверей и гуманоидов, получают ½ урона от несеребряного оружия (кроме стихийного) и дополнительный урон серебром (стр. 162).</p>
  </div>

  {{> "systems/vedmak/templates/actor/parts/monster-abilities.hbs"}}
</section>

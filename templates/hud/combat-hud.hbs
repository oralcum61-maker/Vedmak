{{!-- Худ «Медальон на цепи» (PLAN 4.163, макет design/12-hud-medallion). Медальон — два слоя SVG: неподвижный (подставка,
      обод, жёлоб, портрет) и дуги (их переход перерисовывает только свой слой); числа, монеты, камешки, кольцо хода и
      вспышки — HTML поверх, чтобы их анимации шли на видеокарте. Открытый список рисуется один, над медальоном. --}}
{{#*inline "hmSock"}}
<a class="hm-sock{{#if s.spell}} spell{{/if}}{{#unless s}} empty{{/unless}}" data-index="{{index}}"
   {{#if s}}data-action="socket" data-key="{{s.key}}" data-type="{{s.type}}" data-kind="{{s.kind}}" data-item-id="{{s.itemId}}"
   data-tooltip="{{s.tip}}<br><i>Щелчок — {{#if s.spell}}сотворить{{else}}{{s.verb}}{{/if}}, Shift — без окна. Сюда можно перетащить удар или заклинание</i>"
   {{else}}data-tooltip="Пустое гнездо: перетащите сюда удар из «+» или заклинание из гримуара"{{/if}}>
  {{#if s}}<img src="{{s.img}}" alt=""><b><span>{{s.base}}</span></b>{{/if}}<i class="hm-sflash"></i>
</a>
{{/inline}}
{{#if actor}}
<div class="hm{{#if collapsed}} collapsed{{/if}}{{#if isCurrent}}{{#if inCombat}} turn{{/if}}{{/if}}">
  {{!-- Три колонки: крыло, медальон, крыло; крылья — равной ширины, поэтому медальон всегда по центру --}}
  <div class="hm-row">
    <div class="hm-wing l">
    {{#unless collapsed}}
    <a class="hm-chip{{#if (eq pop "act")}} on{{/if}}" data-action="togglePop" data-pop="act">Действия</a>
    <a class="hm-chip{{#if (eq pop "def")}} on{{/if}}" data-action="togglePop" data-pop="def">Защита</a>
    {{> hmSock s=sockets.[0] index=0}}
    {{/unless}}
    </div>

    <div class="hm-medal">
      <svg class="hm-base" viewBox="0 0 240 210" width="240" height="210" aria-hidden="true">
        <defs>
          <linearGradient id="hm-bez" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f5f0e4"/><stop offset=".28" stop-color="#8e887c"/><stop offset=".48" stop-color="#e2dbcc"/><stop offset=".7" stop-color="#4a463f"/><stop offset="1" stop-color="#c7c0b0"/></linearGradient>
          <pattern id="hm-scr" patternUnits="userSpaceOnUse" width="90" height="90"><image href="systems/vedmak/assets/textures/scratches.webp" width="90" height="90"/></pattern>
          <pattern id="hm-stp" patternUnits="userSpaceOnUse" width="128" height="128"><image href="systems/vedmak/assets/textures/baked/btn-steel.webp" width="128" height="128"/></pattern>
          <linearGradient id="hm-plt" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2c2d32"/><stop offset="1" stop-color="#141518"/></linearGradient>
          <linearGradient id="hm-hpg" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#6e2416"/><stop offset=".6" stop-color="#b8432c"/><stop offset="1" stop-color="#e0735a"/></linearGradient>
          <linearGradient id="hm-stg" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#3c4f2b"/><stop offset=".6" stop-color="#7f9a6c"/><stop offset="1" stop-color="#b4cf96"/></linearGradient>
          <radialGradient id="hm-vig" cx=".5" cy=".45" r=".55"><stop offset=".62" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".62"/></radialGradient>
          <linearGradient id="hm-gls" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".16"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/></linearGradient>
          <clipPath id="hm-pc"><circle cx="120" cy="105" r="46.5"/></clipPath>
        </defs>
        {{!-- Подставка: стальная плита с крыльями, кромка крыла — цвет своей дуги --}}
        <path d="M7 144 L233 144 L242 167 L233 190 L7 190 L-2 167 Z" fill="url(#hm-plt)" stroke="#060708" stroke-width="1.4"/>
        <path d="M7 144 L233 144 L242 167 L233 190 L7 190 L-2 167 Z" fill="url(#hm-stp)" opacity=".5"/>
        <path d="M8.4 145.6 L231.6 145.6" stroke="rgba(255,240,215,.16)" stroke-width="1"/>
        <path d="M7 144.8 L79 144.8" stroke="url(#hm-hpg)" stroke-width="2.6"/>
        <path d="M161 144.8 L233 144.8" stroke="url(#hm-stg)" stroke-width="2.6"/>
        <circle cx="7" cy="167" r="2.6" fill="url(#hm-bez)" stroke="#060708" stroke-width=".8"/><circle cx="233" cy="167" r="2.6" fill="url(#hm-bez)" stroke="#060708" stroke-width=".8"/>
        {{!-- Обод: кованое серебро, царапины, насечки, кромки --}}
        <circle cx="120" cy="105" r="66.5" fill="none" stroke="url(#hm-bez)" stroke-width="11"/>
        <circle cx="120" cy="105" r="66.5" fill="none" stroke="url(#hm-scr)" stroke-width="11" opacity=".35"/>
        <g stroke="#141412">{{#each ticks}}<line x1="{{x1}}" y1="{{y1}}" x2="{{x2}}" y2="{{y2}}" stroke-width="{{w}}"/>{{/each}}</g>
        <circle cx="120" cy="105" r="72" fill="none" stroke="#060708" stroke-width="1.2"/>
        <circle cx="120" cy="105" r="61" fill="none" stroke="#060708" stroke-width="1"/>
        {{!-- Жёлоб под дуги и пустые дорожки --}}
        <circle cx="120" cy="105" r="57" fill="none" stroke="#070809" stroke-width="11.5"/>
        <circle cx="120" cy="105" r="51.6" fill="none" stroke="rgba(255,240,215,.09)" stroke-width=".8"/>
        <path d="{{arcs.hp}}" fill="none" stroke="#24120e" stroke-width="8.5" stroke-linecap="round"/>
        <path d="{{arcs.sta}}" fill="none" stroke="#161d12" stroke-width="8.5" stroke-linecap="round"/>
        {{#if energy}}<path d="{{arcs.en}}" fill="none" stroke="#1a1730" stroke-width="2.2"/>{{/if}}
        {{!-- Портрет под стеклом --}}
        <circle cx="120" cy="105" r="47" fill="#0e0f11"/>
        <image href="{{actor.img}}" x="73.5" y="58.5" width="93" height="93" clip-path="url(#hm-pc)" preserveAspectRatio="xMidYMid slice"/>
        <circle cx="120" cy="105" r="46.5" fill="url(#hm-vig)"/>
        <ellipse cx="120" cy="82" rx="34" ry="20" fill="url(#hm-gls)"/>
        <circle cx="120" cy="105" r="47.3" fill="none" stroke="url(#hm-bez)" stroke-width="1.6"/>
      </svg>
      {{!-- Дуги — свой слой: переход длины перерисовывает только его --}}
      <svg class="hm-arcs" viewBox="0 0 240 210" width="240" height="210" aria-hidden="true">
        <path class="hm-arc hp halo" d="{{arcs.hp}}" pathLength="100" style="stroke-dasharray: {{hp.pct}} 100" fill="none" stroke="#d6503a" stroke-width="13" stroke-linecap="round" opacity=".22"/>
        <path class="hm-trail" d="{{arcs.hp}}" pathLength="100" style="stroke-dasharray: {{hp.pct}} 100" fill="none" stroke="#f3b9aa" stroke-width="8.5" stroke-linecap="round" opacity=".55"/>
        <path class="hm-arc hp" d="{{arcs.hp}}" pathLength="100" style="stroke-dasharray: {{hp.pct}} 100" fill="none" stroke="url(#hm-hpg)" stroke-width="8.5" stroke-linecap="round"/>
        <path class="hm-arc sta halo" d="{{arcs.sta}}" pathLength="100" style="stroke-dasharray: {{sta.pct}} 100" fill="none" stroke="#96be6e" stroke-width="13" stroke-linecap="round" opacity=".2"/>
        <path class="hm-arc sta" d="{{arcs.sta}}" pathLength="100" style="stroke-dasharray: {{sta.pct}} 100" fill="none" stroke="url(#hm-stg)" stroke-width="8.5" stroke-linecap="round"/>
        {{#if wound}}<line x1="{{wound.x1}}" y1="{{wound.y1}}" x2="{{wound.x2}}" y2="{{wound.y2}}" stroke="#060708" stroke-width="2.6"/><line x1="{{wound.x1}}" y1="{{wound.y1}}" x2="{{wound.x2}}" y2="{{wound.y2}}" stroke="#e8dccb" stroke-width=".9"/>{{/if}}
        {{#if energy}}<path class="hm-arc en" d="{{arcs.en}}" pathLength="100" style="stroke-dasharray: {{energy.pct}} 100" fill="none" stroke="#9a88d8" stroke-width="2.2"/>{{/if}}
      </svg>
      <span class="hm-ring" aria-hidden="true"></span>
      <span class="hm-flash" aria-hidden="true"></span><span class="hm-heal" aria-hidden="true"></span><span class="hm-burst" aria-hidden="true"></span>
      <span class="hm-face" data-tooltip="{{actor.name}}{{#if energy}}<br>Энергия {{energy.left}} из {{energy.max}}{{/if}}{{#if wound}}<br>Порог ранения на дуге ПЗ{{/if}}<br><i>Двойной щелчок — лист</i>"></span>
      <span class="hm-num hp{{#if hp.hurt}} hurt{{/if}}{{#if hp.bad}} bad{{/if}}"><i>ПЗ</i><b>{{hp.value}}</b><s>/{{hp.max}}</s></span>
      <span class="hm-num sta"><i>Вын</i><b>{{sta.value}}</b><s>/{{sta.max}}</s></span>
      {{#if luck}}<span class="hm-coins" data-tooltip="Удача {{luck.value}} из {{luck.max}}">
        {{#if luck.many}}<i class="hm-coin"></i><em>{{luck.value}}</em>{{else}}{{#each luck.coins}}<i class="hm-coin{{#unless on}} spent{{/unless}}" style="--x: {{x}}px"></i>{{/each}}{{/if}}
      </span>{{/if}}
      <span class="hm-stones">
        {{#each stones}}
        <span class="hm-stone k-{{kind}}" style="left: {{x}}px; top: {{y}}px" {{#if key}}data-key="{{key}}"{{/if}} data-tooltip="{{tip}}">
          <img src="{{img}}" alt="">{{#if num}}<em>{{num}}</em>{{/if}}
          {{#if close}}<a class="hm-x" data-action="{{close.action}}" {{close.attr}}="{{close.id}}" data-tooltip="{{close.tip}}">×</a>{{/if}}
        </span>
        {{/each}}
        {{#if extraStones}}<a class="hm-stone k-more" style="left: {{extraAt.x}}px; top: {{extraAt.y}}px" data-action="togglePop" data-pop="act" data-tooltip="Ещё {{extraStones}} — в «Действиях»">+{{extraStones}}</a>{{/if}}
      </span>
      {{#if canAdvance}}<a class="hm-endturn" data-action="nextTurn">Конец хода<i class="hm-sheen"></i></a>{{/if}}
    </div>

    <div class="hm-wing r">
    {{#unless collapsed}}
    {{> hmSock s=sockets.[1] index=1}}
    {{#if pops.more}}<a class="hm-more{{#if (eq pop "more")}} on{{/if}}" data-action="togglePop" data-pop="more" data-tooltip="Ещё в руках: {{more.length}}">+{{more.length}}</a>{{/if}}
    {{#if pops.magic}}<a class="hm-chip mag{{#if (eq pop "magic")}} on{{/if}}" data-action="togglePop" data-pop="magic">Магия<sup>{{allSpells.length}}</sup></a>{{/if}}
    {{#if pops.alc}}<a class="hm-chip{{#if (eq pop "alc")}} on{{/if}}" data-action="togglePop" data-pop="alc">Алхимия{{#if flaskCount}}<sup>{{flaskCount}}</sup>{{/if}}</a>{{/if}}
    {{else}}
    <a class="hm-unfold" data-action="toggleCollapse" data-tooltip="Развернуть худ">›</a>
    {{/unless}}
    </div>
  </div>

  {{!-- ───────────── Списки ───────────── --}}
  {{#if (eq pop "def")}}
  <div class="hm-pop def side-l">
    <h4>Защита <i>в ответ на удар</i></h4>
    <div class="hm-dgrid">
      {{#each defenses}}<a class="hm-btn hm-dt" data-action="rollSkill" data-skill="{{key}}" data-tooltip="{{label}}: {{hint}}"><span class="t"><b>{{label}}</b><small>{{sub}}</small></span><span class="hm-stamp"><b>{{base}}</b></span></a>{{/each}}
    </div>
    <div class="hm-cap">Испытания</div>
    <div class="hm-saves">
      <a class="hm-save" data-action="stunSave" data-tooltip="Испытание Устойчивости: d10 меньше порога"><span class="hm-seal"><b>{{stun}}</b></span><span class="t"><b>Устойчивость</b><small>d10 ниже — устоял</small></span></a>
      <a class="hm-save{{#if dying}} bad{{/if}}" data-action="deathSave" data-tooltip="Испытание против смерти: порог — Уст минус накопленный штраф"><span class="hm-seal"><b>{{deathThreshold}}</b></span><span class="t"><b>Против смерти</b><small>{{#if dying}}при смерти — каждый ход{{else}}Уст минус штраф{{/if}}</small></span></a>
    </div>
    <div class="hm-foot"><span>щелчок — бросок</span><span><kbd>⇧</kbd> без окна</span></div>
  </div>
  {{/if}}

  {{#if (eq pop "act")}}
  <div class="hm-pop act side-l">
    <h4>Действия <i>ход, дуэль, навык, состояния</i></h4>
    <div class="hm-agrid">
      <div class="hm-acol">
        <div class="hm-cap">Ход</div>
        <a class="hm-btn" data-action="restTurn" data-tooltip="Ход отдыха: восстановить Выносливость"><span>Отдых<small>вын за ход</small></span><span class="k go">+{{rec}}</span></a>
        <a class="hm-btn" data-action="aimTurn" data-tooltip="Полный ход: +1 к следующей атаке по выбранной цели за ход, до +3. Любая атака сбрасывает"><span>Прицелиться<small>+1 за ход, до +3</small></span><span class="hm-pips">{{#each aimPips}}<i{{#if this}} class="on"{{/if}}></i>{{/each}}</span></a>
        <a class="hm-btn" data-action="manualDamage" data-tooltip="Нанести урон себе без атаки: падение, огонь, яд"><span>Урон без атаки<small>падение, огонь, яд</small></span></a>
        {{#if snailSlime}}<a class="hm-btn{{#if snailSlime.on}} off{{/if}}" {{#unless snailSlime.on}}data-action="igniSlime"{{/unless}} data-tooltip="Школа Улитки: 1 Вын и действие — минуту +3 к защите от разоружения, бросить оружие нельзя"><span>{{#if snailSlime.on}}Слизь Игни держится{{else}}Слизь Игни{{/if}}</span></a>{{/if}}
        {{#if bearForm}}<a class="hm-btn{{#if bearForm.off}} off{{/if}}" {{#unless bearForm.off}}data-action="bearForm"{{/unless}} data-form="{{bearForm.action}}" data-tooltip="{{bearForm.hint}}"><span>{{bearForm.label}}</span></a>{{/if}}
        {{#if trueForm}}<a class="hm-btn{{#if trueForm.bad}} bad{{/if}}{{#if trueForm.off}} off{{/if}}" {{#unless trueForm.off}}data-action="trueForm"{{/unless}} data-form="{{trueForm.action}}" data-tooltip="{{trueForm.hint}}"><span>{{trueForm.label}}</span></a>{{/if}}
        {{#if canFlip}}<a class="hm-btn" data-action="flipToken" data-tooltip="Токен в полный рост и обратно (Shift+F)"><span>Перевернуть токен<small>Shift + F</small></span></a>{{/if}}
        {{#if adrenalineRule}}<span class="hm-btn static" data-tooltip="Кости адреналина"><span>Адреналин</span><span class="k">{{adrenaline}}</span></span>{{/if}}
        <div class="hm-cap">Верхом</div>
        <a class="hm-btn" data-action="controlCheck" data-tooltip="Проверка управления конём"><span>Управление</span></a>
        <a class="hm-btn" data-action="ram" data-tooltip="Таран конём"><span>Таран<small>конём</small></span></a>
      </div>
      <div class="hm-acol">
        <div class="hm-cap">Словесная дуэль</div>
        {{#each verbal}}<a class="hm-btn" data-action="verbal" data-verbal="{{key}}"><span>{{label}}</span><span class="k">{{base}}</span></a>{{/each}}
      </div>
      <div class="hm-acol">
        <div class="hm-cap">Навык</div>
        <input type="search" class="hm-skill" list="hm-skill-list" placeholder="Найти навык…" aria-label="Бросок навыка по имени" data-tooltip="Название навыка и Enter; Shift — без окна">
        <datalist id="hm-skill-list">{{#each skillOptions}}<option value="{{this}}"></option>{{/each}}</datalist>
        {{#each quickSkills}}<a class="hm-btn" data-action="rollSkill" data-skill="{{key}}"><span>{{label}}</span><span class="k">{{base}}</span></a>{{/each}}
      </div>
    </div>
    <div class="hm-states">
      <div class="hm-cap">Состояния — щелчок наложит или снимет</div>
      {{#each statusList}}<a class="hm-stc{{#if on}} on{{/if}}{{#if good}} good{{/if}}" data-action="toggleStatus" data-status="{{id}}" data-tooltip="{{hint}}"><img src="{{img}}" alt="">{{name}}{{#if left}}<em>{{left}}</em>{{/if}}</a>{{/each}}
    </div>
    <div class="hm-foot hm-settings">
      <label class="hm-vol" data-tooltip="Громкость звуков системы"><span>Звуки</span><input type="range" class="vd-fx-slider" min="0" max="1" step="0.05" value="{{volume}}" aria-label="Громкость звуков системы"><b class="vd-fx-value">{{volPct}}%</b></label>
      <a class="hm-link" data-action="toggleCollapse">Свернуть худ — останется медальон</a>
    </div>
  </div>
  {{/if}}

  {{#if (eq pop "alc")}}
  <div class="hm-pop alc side-r">
    <h4>Алхимия <i>{{#if flaskCount}}{{flaskCount}} во флаконах{{else}}пусто{{/if}}</i></h4>
    {{#if tox}}
    <div class="hm-tox">
      <span class="lb">Токсичность</span>
      <div class="hm-tube" data-value="{{tox.value}}" data-max="{{tox.max}}"><span class="f" style="width: {{tox.pct}}%"></span><span class="ghost" hidden></span><i style="left: 25%"></i><i style="left: 50%"></i><i style="left: 75%"></i></div>
      <span class="val"><b>{{tox.value}}</b><s> / {{tox.max}}</s></span>
      <span class="hm-toxnote">Наведите на флакон — покажу, сколько добавит</span>
    </div>
    {{/if}}
    {{#each alchemy}}
    <div class="hm-cap">{{label}}</div>
    <div class="hm-flasks">
      {{#each flasks}}
      <a class="hm-flask v-{{action}}" data-action="useAlchemical" data-item-id="{{id}}" data-tox="{{tox}}" data-name="{{name}}" data-tooltip="{{tip}}">
        {{#if onBlade}}<span class="hm-onw">на клинке</span>{{/if}}
        <span class="fr"><img src="{{img}}" alt=""><span class="q">{{quantity}}</span></span><span class="nm">{{name}}</span><span class="vb">{{verb}}{{#if tox}}<em>+{{tox}}</em>{{/if}}</span>
      </a>
      {{/each}}
    </div>
    {{else}}
    <p class="hm-empty">Зелий, масел и бомб в сумке нет — их делают на вкладке «Ремесло».</p>
    {{/each}}
    <div class="hm-foot"><span>щелчок — {{#if alchemy.length}}выпить, бросить, нанести{{else}}—{{/if}}</span></div>
  </div>
  {{/if}}

  {{#if (eq pop "more")}}
  <div class="hm-pop more side-r">
    <h4>Ещё в руках <i>перетащите в гнездо</i></h4>
    {{#each more}}
    <a class="hm-orow" data-action="attack" data-kind="{{kind}}" data-item-id="{{itemId}}" data-socket-key="{{key}}" data-tooltip="{{tip}}">
      <img src="{{img}}" alt=""><span class="n">{{label}}<small>{{verb}} · {{damage}}</small></span><span class="hm-stamp"><b>{{base}}</b></span>
    </a>
    {{/each}}
    <div class="hm-foot"><span>щелчок — удар</span><span><kbd>⇧</kbd> без окна</span></div>
  </div>
  {{/if}}

  {{#if (eq pop "magic")}}
  <div class="hm-pop magic side-r hm-grim" data-energy="{{#if energy}}{{energy.left}}{{/if}}">
    <h4>Магия <i>вын {{sta.value}} / {{sta.max}}{{#if energy}} · энергия {{energy.left}} / {{energy.max}}{{/if}}</i></h4>
    <input type="search" class="hm-find" placeholder="Найти среди {{allSpells.length}}…    /" aria-label="Найти заклинание">
    <div class="hm-kinds">
      {{#each magicKinds}}<a class="hm-kind{{#if active}} on{{/if}}" data-action="magicKind" data-kind="{{id}}">{{label}}<b>{{count}}</b></a>{{/each}}
      {{#if elements.length}}<span class="hm-els">{{#each elements}}<a class="hm-el el-{{id}}" data-element="{{id}}" data-tooltip="{{label}}"><i></i></a>{{/each}}</span>{{/if}}
    </div>
    {{#if favorites.length}}
    <div class="hm-favs">
      {{#each favorites}}<a class="hm-fav{{#if short}} short{{/if}}" data-action="castSpell" data-item-id="{{id}}" data-hotkey="{{hotkey}}" data-socket-key="spell:{{id}}" data-tooltip="{{name}} — клавиша {{hotkey}}"><kbd>{{hotkey}}</kbd><img src="{{img}}" alt=""><b>{{cost}} {{resource}}</b></a>{{/each}}
    </div>
    {{/if}}
    <div class="hm-glist">
      {{#each levelGroups}}
      <div class="hm-lvl">
        <div class="hm-lvlh">{{#if diamonds}}<span class="dm">{{diamonds}}</span>{{/if}}{{label}}<i>{{rows.length}}</i></div>
        <div class="hm-cols">
          {{#each rows}}
          <a class="hm-sp{{#if short}} short{{/if}}" data-action="castSpell" data-item-id="{{id}}" data-kind="{{kind}}" data-element="{{element}}" data-search="{{search}}" data-fav="{{#if fav}}1{{else}}0{{/if}}"
             data-name="{{name}}" data-sub="{{sub}}" data-cost="{{cost}}" data-need="{{need}}" data-resource="{{resource}}" data-range="{{range}}" data-duration="{{duration}}" data-socket-key="spell:{{id}}">
            <img src="{{img}}" alt=""><span class="nm">{{#if fav}}<em>★</em>{{/if}}{{name}}</span><i class="hm-elg el-{{element}}"></i><b>{{cost}}</b>
          </a>
          {{/each}}
        </div>
      </div>
      {{/each}}
      <p class="hm-empty hm-gempty" hidden>Ничего не нашлось — сбросьте стихию или поиск.</p>
    </div>
    <div class="hm-foot"><span><kbd>/</kbd> поиск</span><span><kbd>↑↓</kbd> выбор</span><span><kbd>Enter</kbd> сотворить</span><span><kbd>⇧</kbd> без окна</span>{{#if favorites.length}}<span><kbd>1–{{favorites.length}}</kbd> избранное</span>{{/if}}<span>правый щелчок — ★</span></div>
    <div class="hm-gcard" hidden>
      <div class="gh"><img src="" alt=""><span><b class="hm-gn"></b><small class="hm-gs"></small></span></div>

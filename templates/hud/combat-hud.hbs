{{!-- Худ персонажа (холст design/11, PLAN 4.58): показатели слева, вкладки в середине, ход справа. --}}
{{#if actor}}
<div class="vh{{#if collapsed}} collapsed{{/if}}{{#if isCurrent}} my-turn{{/if}}">
  <button type="button" class="vh-fold" data-action="toggleCollapse" data-tooltip="{{#if collapsed}}Развернуть{{else}}Свернуть{{/if}}" aria-label="{{#if collapsed}}Развернуть худ{{else}}Свернуть худ{{/if}}"><i class="fa-solid fa-chevron-{{#if collapsed}}up{{else}}down{{/if}}"></i></button>

  <div class="vh-side">
    <div class="vh-who">
      <span class="vh-portrait" data-action="openSheet" data-tooltip="Открыть лист"><img src="{{actor.img}}" alt=""></span>
      <div class="vh-name">
        <a data-action="openSheet">{{actor.name}}</a>
        {{#if isCurrent}}<span class="vh-mine">твой ход</span>{{else if inCombat}}<span class="vh-wait">ждёт хода</span>{{else}}<span class="vh-wait">вне боя</span>{{/if}}
      </div>
    </div>
    {{#each vitals}}
    <div class="vh-vit {{key}}" data-tooltip="{{hint}}">
      <span class="vh-cap">{{label}}</span>
      <div class="vh-tube"><span class="f {{key}}" style="width: {{pct}}%"></span>{{#if notch}}<b class="wound" style="left: {{notch}}%"></b>{{/if}}<i style="left: 25%"></i><i style="left: 50%"></i><i style="left: 75%"></i></div>
      <span class="vh-num{{#if bad}} bad{{/if}}"><b>{{value}}</b><small>{{#if suffix}}{{suffix}}{{else}}/{{max}}{{/if}}</small></span>
    </div>
    {{/each}}
    {{#if (or energy.length luck.length)}}
    <div class="vh-pips">
      {{#if energy.length}}<span class="vh-pip-row" data-tooltip="Энергия раунда"><span class="vh-cap">энергия</span>{{#each energy}}<i class="vh-slot{{#if on}} on{{/if}}"></i>{{/each}}</span>{{/if}}
      {{#if luck.length}}<span class="vh-pip-row" data-tooltip="Удача"><span class="vh-cap">удача</span>{{#each luck}}<i class="vd-coin{{#unless on}} off{{/unless}}"></i>{{/each}}</span>{{/if}}
    </div>
    {{/if}}
  </div>

  <div class="vh-center">
    <div class="vh-tabsrow">
      <nav class="vh-switch" aria-label="Разделы худа">
        {{#each tabs}}<a class="{{#if active}}on{{/if}}" data-action="setTab" data-tab="{{id}}">{{label}}{{#if count}} <span class="vh-count">{{count}}</span>{{/if}}</a>{{/each}}
      </nav>
    </div>

    {{#unless collapsed}}
    {{#if showFight}}
    <div class="vh-deck">
      <div class="vh-weapons">
        {{#each attacks}}
        <div class="vh-well vh-wpn">
          <span class="vh-frame"><img src="{{img}}" alt=""></span>
          <div class="vh-wtext" data-tooltip="{{label}}{{#if sub}}<br>{{sub}}{{/if}}"><span class="vh-wname">{{label}}</span><span class="vh-wsub">{{sub}}</span></div>
          {{> "systems/vedmak/templates/actor/parts/medal.hbs" value=base cls="vh-m38"}}
          <div class="vh-dmg"><b>{{damage}}</b><span class="vh-cap">урон</span></div>
          <button type="button" class="vh-go sm" data-action="attack" data-kind="{{kind}}" data-item-id="{{itemId}}">{{#if isRanged}}Выстрел{{else}}Атака{{/if}}</button>
        </div>
        {{/each}}
      </div>
      <div class="vh-grp">
        <span class="vh-cap">защита</span>
        <div class="vh-grid2">
          {{#each defenses}}<button type="button" class="vh-sbtn" data-action="rollSkill" data-skill="{{key}}" data-tooltip="{{label}}"><span class="t">{{label}}</span> <b>{{base}}</b></button>{{/each}}
        </div>
        <span class="vh-cap">испытания</span>
        <div class="vh-grid2">
          <button type="button" class="vh-sbtn" data-action="stunSave" data-tooltip="Испытание Устойчивости"><span class="t">Уст · порог</span> <b>{{stun}}</b></button>
          <button type="button" class="vh-sbtn{{#if dying}} bad{{/if}}" data-action="deathSave" data-tooltip="Испытание против смерти"><span class="t">Против смерти</span> <b>{{deathThreshold}}</b></button>
        </div>
      </div>
    </div>
    {{/if}}

    {{#if showMagic}}
    <div class="vh-deck">
      <div class="vh-signs">
        {{#each spells}}
        <button type="button" class="vh-sign" data-action="castSpell" data-item-id="{{id}}" data-tooltip="{{name}} — {{cost}}">
          <span class="vh-sigm{{#unless sign}} violet{{/unless}}"><span><img src="{{img}}" alt=""></span></span>
          <span class="vh-sn">{{name}}</span><span class="vh-cap">{{cost}}</span>
        </button>
        {{/each}}
      </div>
      {{#if (or maintained.length shield)}}
      <div class="vh-grp vh-held">
        <span class="vh-cap">держится</span>
        {{#if shield}}<div class="vh-well vh-line"><i class="fa-solid fa-shield-halved"></i><span class="vh-ltext">Щит: <b>{{shield}}</b> ПЗ</span></div>{{/if}}
        {{#each maintained}}
        <div class="vh-well vh-line"><img src="{{img}}" alt=""><span class="vh-ltext">{{name}}{{#if cost}} · <b>{{cost}}</b> вын/р{{/if}}</span><button type="button" class="vh-sbtn sm" data-action="endMaintained" data-effect-id="{{id}}">Снять</button></div>
        {{/each}}
      </div>
      {{/if}}
      <div class="vh-aside">
        {{#if energyMax}}<p>Энергия раунда: <b class="violet">{{energyLeft}}</b> из {{energyMax}}</p>{{/if}}
        <p>Щелчок — окно сотворения, с Shift — сразу, без окна.</p>
      </div>
    </div>
    {{/if}}

    {{#if showAlchemy}}
    <div class="vh-deck">
      {{#if alchemy.length}}
      <div class="vh-potions">
        {{#each alchemy}}
        <div class="vh-well vh-potion" data-tooltip="{{hint}}">
          <span class="vh-pic"><img src="{{img}}" alt=""><span class="vh-qty">×{{quantity}}</span></span>
          <span class="vh-pn">{{name}}</span><span class="vh-tx">{{note}}</span>
          <button type="button" class="vh-go xs {{go}}" data-action="useAlchemical" data-item-id="{{id}}">{{actionLabel}}</button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <span class="vh-empty">Зелий, масел и бомб в сумке нет — их делают на вкладке «Ремесло».</span>
      {{/if}}
      {{#if tox}}
      <div class="vh-aside">
        <span class="vh-cap">токсичность</span>
        <div class="vh-tube"><span class="f tox" style="width: {{tox.pct}}%"></span><i style="left: 25%"></i><i style="left: 50%"></i><i style="left: 75%"></i></div>
        <p><b class="violet">{{tox.value}}%</b> из {{tox.max}}% — выше предела отравление.</p>
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{#if showActions}}
    <div class="vh-deck vh-rows">
      <div class="vh-row">
        <button type="button" class="vh-sbtn" data-action="restTurn" data-tooltip="Ход отдыха: восстановить Выносливость">Отдых (ход) <b class="ok">+{{rec}}</b></button>
        <button type="button" class="vh-sbtn" data-action="manualDamage">Урон без атаки</button>
        <button type="button" class="vh-sbtn" data-action="controlCheck">Управление конём</button>
        <button type="button" class="vh-sbtn" data-action="ram">Таран</button>
        {{#if canFlip}}<button type="button" class="vh-sbtn" data-action="flipToken" data-tooltip="Токен в полный рост и обратно (Shift+F)">Перевернуть токен</button>{{/if}}
        {{#if adrenalineRule}}<span class="vh-sbtn static">Адреналин <b>{{adrenaline}}</b></span>{{/if}}
      </div>
      <div class="vh-row">
        <span class="vh-cap">словесная дуэль</span>
        {{#each verbal}}<button type="button" class="vh-sbtn sm" data-action="verbal" data-verbal="{{key}}">{{label}} <b>{{base}}</b></button>{{/each}}
      </div>
      <div class="vh-row">
        <span class="vh-cap">навык</span>
        <input type="search" class="vh-skill" list="vh-skill-list" placeholder="Внимание, Скрытность… и Enter" aria-label="Бросок навыка по имени">
        <datalist id="vh-skill-list">{{#each skillOptions}}<option value="{{this}}"></option>{{/each}}</datalist>
        <button type="button" class="vh-sbtn sm" data-action="rollSkill" data-skill="awareness">Внимание</button>
        <button type="button" class="vh-sbtn sm" data-action="rollSkill" data-skill="stealth">Скрытность</button>
      </div>
    </div>
    {{/if}}

    {{#if showStates}}
    <div class="vh-deck vh-rows">
      <div class="vh-row">
        <span class="vh-cap">действует</span>
        {{#each effects}}<span class="vh-st{{#if bad}} bad{{/if}}"><img src="{{img}}" alt="">{{name}}{{#if left}} <em>{{left}}</em>{{/if}}</span>{{else}}<span class="vh-empty">ничего</span>{{/each}}
      </div>
      <div class="vh-sgrid">
        {{#each statusList}}<button type="button" class="{{#if on}}on{{/if}}" data-action="toggleStatus" data-status="{{id}}" data-tooltip="{{hint}}">{{name}}</button>{{/each}}
      </div>
    </div>
    {{/if}}
    {{/unless}}
  </div>

  <div class="vh-turn">
    {{#if inCombat}}
    <span class="vh-cap">раунд</span>
    {{> "systems/vedmak/templates/actor/parts/medal.hbs" value=round cls="vh-m52"}}
    <span class="vh-next">дальше: <b>{{nextName}}</b></span>
    {{#if canAdvance}}<button type="button" class="vh-go wide" data-action="nextTurn">Конец хода</button>{{/if}}
    {{else}}
    <span class="vh-cap">вне боя</span>
    {{/if}}
  </div>
</div>
{{/if}}

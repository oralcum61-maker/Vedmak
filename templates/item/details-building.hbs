{{!-- Постройка (PLAN 4.185): что это за здание по уровням и, в поселении, его состояние. Выработка и содержание —
     броски («1d6+3»), за постройку или за каждую семью на работе. --}}
<section class="tab details {{tab.cssClass}} building-details" data-group="primary" data-tab="details">
  <datalist id="bl-resources-{{item.id}}">{{#each building.resourceNames}}<option value="{{this}}"></option>{{/each}}</datalist>
  <fieldset class="vd-fieldset">
    <legend>Постройка</legend>
    <div class="vd-grid g2">
      <label>Группа <select name="system.group">{{selectOptions building.groups selected=system.group}}</select></label>
      <label data-tooltip="По коду поселение узнаёт одинаковые постройки (одна на поселение). Пусто — название">Код
        <input type="text" name="system.key" value="{{system.key}}" placeholder="{{building.codePlaceholder}}"></label>
    </div>
    <div class="bl-checks">
      <label class="checkbox"><input type="checkbox" name="system.unique" {{checked system.unique}}> Одна на поселение</label>
      <label class="checkbox"><input type="checkbox" name="system.trade" {{checked system.trade}}> Торговый пост</label>
    </div>
  </fieldset>

  {{#if building.inSettlement}}
  <fieldset class="vd-fieldset">
    <legend>В поселении «{{building.settlement}}»</legend>
    <div class="vd-grid g4">
      <label>Уровень <input type="number" name="system.level" value="{{system.level}}" min="0" max="{{building.maxLevel}}" step="1"></label>
      <label>Работают, семей <input type="number" name="system.workers" value="{{system.workers}}" min="0" step="1"></label>
      <label>Стройка, нед. <input type="number" name="system.progress" value="{{system.progress}}" min="0" step="1"></label>
      <label class="checkbox"><input type="checkbox" name="system.constructing" {{checked system.constructing}}> Строится</label>
    </div>
  </fieldset>
  {{/if}}

  {{#each building.levels as |lv|}}
  <fieldset class="vd-fieldset bl-level">
    <legend>Уровень {{lv.n}}{{#if @root.building.canDelete}}<a data-action="blLevelDelete" data-level="{{lv.index}}" data-tooltip="Убрать уровень"><i class="fa-solid fa-xmark"></i></a>{{/if}}</legend>
    <div class="vd-grid g3">
      {{#each lv.fields}}<label data-tooltip="{{hint}}">{{label}} <input type="number" name="{{name}}" value="{{value}}" min="0" step="{{step}}"></label>{{/each}}
    </div>

    <div class="bl-list">
      <span class="field-label">Цена</span>
      {{#each lv.cost}}
      <div class="bl-cost">
        <input type="text" name="{{resource.name}}" value="{{resource.value}}" list="bl-resources-{{@root.item.id}}" placeholder="Ресурс или Богатство">
        <input type="number" name="{{qty.name}}" value="{{qty.value}}" min="0" step="any">
        <a data-action="blDelete" data-level="{{level}}" data-list="cost" data-index="{{j}}"><i class="fa-solid fa-xmark"></i></a>
      </div>
      {{/each}}
      <a class="bl-plus" data-action="blAdd" data-level="{{lv.index}}" data-list="cost"><i class="fa-solid fa-plus"></i> ресурс</a>
    </div>

    {{#each lv.lists as |L|}}
    <div class="bl-list">
      <span class="field-label">{{L.label}}</span>
      {{#if L.rows.length}}
      <table class="bl-rows">
        <thead><tr><th>Ресурс</th><th>Бросок</th><th>Кому</th><th>Как часто</th><th data-tooltip="Нужно семей на работе">Семей</th>
          <th data-tooltip="Зимой нет">Не зимой</th>{{#if L.same}}<th data-tooltip="Столько же, сколько выпало строкой выше">Столько же</th>{{/if}}<th></th></tr></thead>
        <tbody>
          {{#each L.rows}}
          <tr>
            <td><input type="text" name="{{resource.name}}" value="{{resource.value}}" list="bl-resources-{{@root.item.id}}"></td>
            <td><input type="text" name="{{formula.name}}" value="{{formula.value}}" class="bl-formula"></td>
            <td><select name="{{per.name}}">{{selectOptions @root.building.perOptions selected=per.value}}</select></td>
            <td><select name="{{period.name}}">{{selectOptions @root.building.periodOptions selected=period.value}}</select></td>
            <td><input type="number" name="{{minFamilies.name}}" value="{{minFamilies.value}}" min="0" step="1"></td>
            <td class="c"><input type="checkbox" name="{{noWinter.name}}" {{checked noWinter.value}}></td>
            {{#if L.same}}<td class="c"><input type="checkbox" name="{{same.name}}" {{checked same.value}}></td>{{/if}}
            <td><a data-action="blDelete" data-level="{{level}}" data-list="{{list}}" data-index="{{j}}"><i class="fa-solid fa-xmark"></i></a></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
      <a class="bl-plus" data-action="blAdd" data-level="{{lv.index}}" data-list="{{L.list}}"><i class="fa-solid fa-plus"></i> строка</a>
    </div>
    {{/each}}
  </fieldset>
  {{/each}}
  {{#if editable}}<button type="button" class="bl-add" data-action="blLevelAdd"><i class="fa-solid fa-plus"></i> Добавить уровень</button>{{/if}}
</section>
